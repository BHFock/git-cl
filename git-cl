# Set by 'git cl commit' for its own 'git commit' call. A post-commit hook
# running 'git cl prune' then returns immediately, so that the hook only
# acts on commits made outside git-cl. Otherwise it would empty a
# changelist committed with --keep, and its changes would be overwritten
# when 'git cl commit' saves the changelists it loaded before committing.
NO_PRUNE_ENV = "GIT_CL_NO_PRUNE"


class ClutilSaveError(OSError):
    """
    Raised when changelist or stash metadata cannot be written.

    The save functions print the reason before raising, so callers only
    need to stop and report failure. main() turns an unhandled one into
    exit code 1, which keeps commands from reporting success when their
    changes were not saved.
    """


class ClutilLoadError(Exception):
    """
    Raised when 'cl.json' or 'cl-stashes.json' cannot be read or is invalid.

    The load functions print the reason and how to recover before raising.
    main() turns it into exit code 1, so that no command carries on with
    empty data and overwrites the file on its next save.
    """


# Note: Some utility functions call CLI command functions like cl_stash and
#       cl_unstash. These are defined later in the module but are called by
#       utility functions.


def clutil_print_error(*values: object, **kwargs) -> None:
    """
    Prints an error, a warning or a hint that belongs to one on stderr.

    Keeping these messages off stdout lets scripts and integrations tell
    regular output apart from problems, as Git itself does. Takes the
    same arguments as print().
    """
    print(*values, file=sys.stderr, **kwargs)


@contextmanager
def clutil_file_lock(lock_path: Path):
    """
    Acquires an exclusive lock on a file for safe concurrent access.

    Creates a lock file and acquires an exclusive lock to prevent concurrent
    access to shared resources. The lock file is automatically cleaned up
    when the context exits, regardless of whether an exception occurs.

    Args:
        lock_path (Path): Path to the lock file to create and lock.

    Yields:
        None

    Raises:
        OSError: If the lock file cannot be created or locked.

    Platform notes:
        On Unix, ``fcntl.flock`` acquires a whole-file advisory lock that
        blocks indefinitely until the lock becomes available.
        On Windows, ``msvcrt.locking`` locks a single byte (the file is
        empty and used only for mutual exclusion, so one byte suffices).
        Unlike ``fcntl.flock``, ``msvcrt.locking`` with ``LK_LOCK`` retries
        for approximately ten seconds before raising ``OSError``.  This is
        acceptable because changelist operations are fast.

    Example:
        >>> lock_file = Path('.git/cl.lock')
        >>> with clutil_file_lock(lock_file):
        ...     # Perform operations that need exclusive access
        ...     pass
        # Lock file is automatically cleaned up here
    """
    lock_file = None
    try:
        lock_file = open(lock_path, 'w', encoding='utf-8')
        if sys.platform == "win32":
            msvcrt.locking(lock_file.fileno(), msvcrt.LK_LOCK, 1)
        else:
            fcntl.flock(lock_file, fcntl.LOCK_EX)
        yield
    finally:
        if lock_file:
            if sys.platform == "win32":
                try:
                    msvcrt.locking(lock_file.fileno(), msvcrt.LK_UNLCK, 1)
                except OSError:
                    pass
            else:
                fcntl.flock(lock_file, fcntl.LOCK_UN)
            lock_file.close()
            lock_path.unlink(missing_ok=True)


def clutil_should_use_color(args) -> bool:
    """
    Determines whether coloured output should be used in CLI display.

    This function checks multiple conditions to decide if colour formatting
    is appropriate:
    - The --no-color flag is not set.
    - The NO_COLOR environment variable is not set.
    - The output is being sent to a terminal (TTY).
    - The 'colorama' module is available.

    Args:
        args (argparse.Namespace): Parsed command-line arguments, expected to
                                   include the 'no_color' attribute.

    Returns:
        bool: True if coloured output should be enabled, False otherwise.
    """
    no_color_env = bool(os.environ.get('NO_COLOR'))
    is_tty = sys.stdout.isatty()
    return (not (args.no_color or no_color_env or not is_tty) and
            COLORAMA_AVAILABLE)


def clutil_resolve_commit_message(args: argparse.Namespace) -> Optional[str]:
    """
    Resolves the commit message from CLI arguments.

    Args:
        args (argparse.Namespace): Parsed arguments with 'message' or 'file'.

    Returns:
        Optional[str]: The commit message, or None if resolution fails.
    """
    if args.message:
        return args.message

    if args.file:
        try:
            return clutil_read_commit_message_file(args.file)
        except (OSError, ValueError) as error:
            clutil_print_error(f"Error reading commit message file '{args.file}': "
                               f"{error}")
            return None

    clutil_print_error("Error: No commit message provided.")
    return None


def clutil_get_file() -> Path:
    """
    Returns the path to the changelist file inside the Git directory.

    Returns:
        Path: Path to the '.git/cl.json' file.

    Raises:
        SystemExit: If not inside a Git repository.
    """
    try:
        git_dir = subprocess.check_output(
            ["git", "rev-parse", "--git-dir"],
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()
        return Path(git_dir) / "cl.json"
    except subprocess.CalledProcessError:
        clutil_print_error("Error: Not inside a Git repository.")
        clutil_print_error("Please run this command from within a Git repository.")
        sys.exit(1)


def clutil_is_string_list(value) -> bool:
    """Return True if value is a list of strings."""
    return isinstance(value, list) and all(isinstance(v, str) for v in value)


def clutil_check_changelist_data(data) -> Optional[str]:
    """
    Check that loaded changelist data has the expected structure.

    Args:
        data: Parsed content of 'cl.json'

    Returns:
        A description of the first problem found, or None if the data is
        a mapping of changelist names to lists of file paths.
    """
    if not isinstance(data, dict):
        return "expected an object mapping changelist names to file lists"
    for name, files in data.items():
        if not clutil_is_string_list(files):
            return f"changelist '{name}' is not a list of file paths"
    return None


def clutil_check_stash_data(data) -> Optional[str]:
    """
    Check that loaded stash metadata has the fields git-cl relies on.

    Args:
        data: Parsed content of 'cl-stashes.json'

    Returns:
        A description of the first problem found, or None if every entry
        has a 'stash_ref' string and a 'files' list, and 'file_categories',
        if present, maps category names to lists of file paths.
    """
    if not isinstance(data, dict):
        return "expected an object mapping changelist names to stash records"
    for name, record in data.items():
        if not isinstance(record, dict):
            return f"the record for '{name}' is not an object"
        if not isinstance(record.get("stash_ref"), str):
            return f"the record for '{name}' has no valid 'stash_ref'"
        if not clutil_is_string_list(record.get("files")):
            return f"the record for '{name}' has no valid 'files' list"
        if not isinstance(record.get("stash_commit", ""), str):
            return f"the record for '{name}' has an invalid 'stash_commit'"
        categories = record.get("file_categories", {})
        if not (isinstance(categories, dict) and
                all(clutil_is_string_list(v) for v in categories.values())):
            return f"the record for '{name}' has invalid 'file_categories'"
    return None


def clutil_read_json_file(
    path: Path,
    check: Callable[[object], Optional[str]]
) -> dict:
    """
    Read and check a git-cl metadata file.

    An empty file counts as no data. Any other problem stops git-cl:
    carrying on with empty data would overwrite the file on the next save
    and lose everything in it.

    Args:
        path: File to read
        check: Function returning a problem description or None

    Returns:
        dict: The parsed data.

    Raises:
        ClutilLoadError: If the file cannot be read, is not valid JSON or
            fails the check. The reason has already been printed.
    """
    try:
        with open(path, "r", encoding="utf-8") as file_handle:
            content = file_handle.read()
        if not content.strip():
            return {}
        data = json.loads(content)
        problem = check(data)
    except OSError as error:
        problem = error.strerror or str(error)
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        problem = f"not valid JSON ({error})"
    if problem is None:
        return data

    clutil_print_error(f"Error: Cannot use {path}: {problem}.")
    clutil_print_error("git-cl has stopped, so that the file is not "
                       "overwritten.")
    clutil_print_load_recovery_hint(path)
    raise ClutilLoadError(str(path))


def clutil_print_load_recovery_hint(path: Path) -> None:
    """
    Print how to recover from an unusable metadata file.

    Args:
        path: The unusable 'cl.json' or 'cl-stashes.json'
    """
    clutil_print_error("Repair the file, or move it aside to continue "
                       "without it:")
    clutil_print_error(f"  mv {shlex.quote(str(path))} "
                       f"{shlex.quote(str(path) + '.broken')}")
    if path.name == "cl-stashes.json":
        clutil_print_error("git-cl then no longer knows its stashed "
                           "changelists. Their changes stay in "
                           "'git stash list'.")
    else:
        clutil_print_error("git-cl then starts without changelists. Your "
                           "files are not affected.")


def clutil_load() -> dict[str, list[str]]:
    """
    Loads changelist data from the 'cl.json' file.

    Returns:
        dict: A mapping of changelist names to lists of file paths.

    Raises:
        ClutilLoadError: If the file exists but cannot be used. The reason
            has already been printed.
    """
    changelist_file = clutil_get_file()
    lock_file = changelist_file.with_suffix('.lock')
    if changelist_file.exists():
        with clutil_file_lock(lock_file):
            return clutil_read_json_file(changelist_file,
                                         clutil_check_changelist_data)
    return {}


def clutil_save(data: dict[str, list[str]]) -> None:
    """
    Saves the changelist data to 'cl.json', omitting empty changelists.

    Writes are atomic: the data is first written to a temporary file in the
    same directory, then renamed over the target. If the process is
    interrupted mid-write, the original file is left untouched.

    Args:
        data (dict): Mapping of changelist names to lists of files.

    Raises:
        ClutilSaveError: If the file cannot be written. The error has
            already been printed.
    """
    changelist_file = clutil_get_file()
    lock_file = changelist_file.with_suffix('.lock')
    cleaned = {k: v for k, v in data.items() if v}
    with clutil_file_lock(lock_file):
        tmp_path = None
        try:
            fd, tmp_path = tempfile.mkstemp(
                dir=changelist_file.parent,
                prefix='.cl.json.',
                suffix='.tmp'
            )
            with os.fdopen(fd, 'w', encoding='utf-8') as file_handle:
                json.dump(cleaned, file_handle, indent=2)
            os.replace(tmp_path, changelist_file)
            tmp_path = None  # successfully renamed, nothing to clean up
        except OSError as error:
            clutil_print_error(f"Error saving changelists: {error}")
            raise ClutilSaveError(str(error)) from error
        finally:
            if tmp_path is not None:
                try:
                    os.unlink(tmp_path)
                except OSError:
                    pass


def clutil_validate_name(name: str) -> bool:
    """
    Validates that a changelist name is safe to use.

    Args:
        name (str): The changelist name to validate.

    Returns:
        bool: True if the name is valid, False otherwise.
    """
    # Check for empty names
    if not name:
        return False

    # Check for reasonable length (max 100 characters)
    if len(name) > 100:
        return False

    # Only allow safe characters: letters, numbers, hyphens, underscores, dots
    allowed_chars = set(
        'abcdefghijklmnopqrstuvwxyz'
        'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
        '0123456789-_.'
    )

    if not all(char in allowed_chars for char in name):
        return False

    # Don't allow names that are only dots (filesystem issues)
    if all(char == '.' for char in name):
        return False

    # Check for Git reserved words (only the critical ones)
    reserved_names = {'HEAD', 'FETCH_HEAD', 'ORIG_HEAD', 'MERGE_HEAD',
                      'CHERRY_PICK_HEAD', 'index'}
    if name in reserved_names:
        return False

    return True


def clutil_plural(count: int, singular: str, plural: str = "") -> str:
    """Return e.g. '1 file' or '3 files'."""
    return f"{count} {singular if count == 1 else (plural or singular + 's')}"


def clutil_has_commits() -> bool:
    """Return True if HEAD points to a commit, False before the first one."""
    result = subprocess.run(["git", "rev-parse", "--verify", "--quiet", "HEAD"],
                            capture_output=True, text=True, check=False)
    return result.returncode == 0


def clutil_is_skip_worktree(path: Path) -> bool:
    """
    Return True if a tracked file is outside the sparse checkout.

    Such a file is tracked and unchanged, but Git does not write it to
    the working directory ('git ls-files -t' marks it with 'S').
    """
    result = subprocess.run(["git", "ls-files", "-t", "--"]
                            + clutil_literal_pathspecs([str(path)]),
                            capture_output=True, text=True, check=False)
    return result.stdout.startswith("S ")


def clutil_get_git_root() -> Path:
    """
    Returns the absolute path to the root of the current Git repository.

    Returns:
        Path: The top-level directory of the Git repository.

    Raises:
        SystemExit: If the current directory is not inside a Git repository.
    """
    result = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                            capture_output=True, text=True, check=False)
    if result.returncode == 0:
        return Path(result.stdout.strip()).resolve()
    bare = subprocess.run(["git", "rev-parse", "--is-bare-repository"],
                          capture_output=True, text=True, check=False)
    if bare.stdout.strip() == "true":
        clutil_print_error("Error: This is a bare repository. git-cl needs a "
                           "working directory with files.")
    else:
        clutil_print_error("Error: Not inside a Git repository.")
    sys.exit(1)


def clutil_get_git_status(
        include_untracked: bool = False
) -> list[tuple[str, str, Optional[str]]]:
    """
    Returns the entries of 'git status --porcelain -z'.

    The -z form gives every path exactly as it is, separated by NUL bytes.
    Without it, Git puts paths with spaces in double quotes and, by
    default, writes non-ASCII characters such as umlauts as octal escapes
    ("\\303\\234bersicht.md"), so they would not match the paths stored
    in changelists.

    Args:
        include_untracked (bool): If True, includes untracked files using
                                  '--untracked-files=all'.

    Returns:
        list of (code, path, orig_path): The two-letter status code, the
        path, and for a rename or copy the original path (else None).
        Paths are relative to the git root.

    Raises:
        SystemExit: If the git command fails.
    """
    cmd = ["git", "status", "--porcelain", "-z"]
    if include_untracked:
        cmd.append("--untracked-files=all")
    else:
        cmd.append("--untracked-files=no")

    try:
        output = subprocess.check_output(cmd)
    except subprocess.CalledProcessError as error:
        clutil_print_error(f"Error getting git status: {error}")
        sys.exit(1)

    # Decode as Git writes paths: UTF-8, keeping undecodable bytes intact
    fields = output.decode("utf-8", errors="surrogateescape").split("\0")

    entries = []
    index = 0
    while index < len(fields):
        field = fields[index]
        index += 1
        if len(field) < 4:
            continue  # trailing empty field or malformed entry
        code, path = field[:2], field[3:]
        orig_path = None
        # A rename or copy is followed by a second field: the original path
        if "R" in code or "C" in code:
            if index < len(fields):
                orig_path = fields[index]
                index += 1
        entries.append((code, path, orig_path))
    return entries


def clutil_resolve_file(path: Path) -> Path:
    """
    Make a file path absolute without following a symlink in its last
    component.

    Git treats a symbolic link as a file of its own and never follows it.
    Path.resolve() does follow it, which would turn 'link.txt' into the
    file it points to. So only the directories before the last component
    are resolved; '..' and '.' are normalised first.

    Args:
        path: An absolute path, or one relative to the current directory

    Returns:
        The absolute path, with the last component kept as it is.
    """
    path = Path(os.path.abspath(path))
    if path.name in ("", ".", ".."):
        return path.resolve()
    return path.parent.resolve() / path.name


def clutil_path_exists(path: Path) -> bool:
    """
    Whether a path exists, counting a symlink as existing even if it
    points to a missing file.
    """
    return os.path.lexists(path)


def clutil_is_real_dir(path: Path) -> bool:
    """
    Whether a path is a directory and not a symlink to one. Git tracks a
    symlink to a directory as a single file.
    """
    return path.is_dir() and not path.is_symlink()


def clutil_sanitize_path(file_path: str, git_root: Path) -> Optional[str]:
    """
    Sanitizes and validates a file path for safe use with Git commands.

    Args:
        file_path (str): The file path to sanitize
        git_root (Path): The root directory of the Git repository

    Returns:
        str | None: The sanitized path relative to git_root, or None if invalid
    """
    try:
        # Convert to Path object and resolve any relative components
        path = Path(file_path)

        # If it's relative, make it relative to current working directory
        if not path.is_absolute():
            path = Path.cwd().resolve() / path

        # Resolve any .. or . components and get absolute path. A symlink
        # in the last component is kept: it is a file of its own for Git.
        path = clutil_resolve_file(path)

        # Ensure the path is within the Git repository
        try:
            relative_path = path.relative_to(git_root)
        except ValueError:
            # Path is outside the Git repository
            return None

        # Convert back to string using forward slashes (Git standard)
        sanitized = relative_path.as_posix()

        # Basic security check: reject paths with dangerous characters
        dangerous_chars = [';', '|', '&', '`', '$', '\n', '\r', '\0']
        if any(char in sanitized for char in dangerous_chars):
            return None

        return sanitized

    except (OSError, ValueError, RuntimeError):
        # Any path resolution errors
        return None


def clutil_literal_pathspecs(paths: Iterable[str]) -> list[str]:
    """
    Marks paths for Git as literal file names, not patterns.

    Git reads paths after '--' as pathspecs: '*', '?' and '[' are
    wildcards, and a leading ':' starts pathspec magic. A changelist entry
    such as '*.md' would otherwise also stage, stash or show x.md. The
    ':(literal)' prefix applies to each path only, so Git hooks and
    other commands run by Git are not affected.

    If GIT_LITERAL_PATHSPECS is set, Git takes all paths literally and
    would read the prefix as part of the name, so the paths are returned
    unchanged.

    Args:
        paths: File paths as passed to Git (repository- or CWD-relative).
    Returns:
        list[str]: The paths, each with the ':(literal)' prefix.
    """
    literal_env = os.environ.get("GIT_LITERAL_PATHSPECS", "").strip().lower()
    if literal_env in ("1", "true", "yes", "on"):
        return list(paths)
    return [f":(literal){path}" for path in paths]


def clutil_ignores_case() -> bool:
    """
    Returns True if Git treats paths case-insensitively in this repository
    (core.ignorecase, set by Git on macOS and Windows file systems).
    """
    result = subprocess.run(["git", "config", "--bool", "core.ignorecase"],
                            capture_output=True, text=True, check=False)
    return result.stdout.strip() == "true"


def clutil_match_case(rel_path: str, known: Iterable[str],
                      git_root: Path) -> str:
    """
    Returns the spelling of a path that Git and the file system use, for
    a path typed in another case on a case-insensitive file system.

    Git compares paths case-sensitively, so 'readme.md' typed for the
    file 'README.md' would never match its status, diff or stage. The
    spelling of a known path wins (Git's index, status or stored
    changelist entries); otherwise each component is matched against the
    directory listing. Only call this when clutil_ignores_case() is True.

    Args:
        rel_path: Path relative to the repository root, as typed.
        known: Paths relative to the root whose spelling is authoritative.
        git_root: The root directory of the Git repository.
    Returns:
        str: The matching spelling, or rel_path if there is no single match.
    """
    known = list(known)
    if rel_path in known:
        return rel_path
    folded = rel_path.casefold()
    matches = sorted({k for k in known if k.casefold() == folded})
    if len(matches) == 1:
        return matches[0]
    if matches:
        return rel_path

    current = git_root
    parts = []
    for part in rel_path.split("/"):
        try:
            names = os.listdir(current)
        except OSError:
            return rel_path
        if part not in names:
            candidates = [n for n in names if n.casefold() == part.casefold()]
            if len(candidates) != 1:
                return rel_path
            part = candidates[0]
        parts.append(part)
        current = current / part
    return "/".join(parts)


def clutil_known_paths(git_root: Path, status_map: dict[str, str],
                       changelists: dict[str, list[str]]) -> list[str]:
    """
    Returns paths relative to the repository root whose spelling Git
    knows: tracked files, changed files and stored changelist entries.
    """
    result = subprocess.run(["git", "ls-files", "-z"], cwd=git_root,
                            capture_output=True, text=True, check=False)
    known = [p for p in result.stdout.split("\0") if p]
    known.extend(status_map)
    for files in changelists.values():
        known.extend(files)
    return known


def clutil_status_path_to_rel(raw_path: str, git_root: Path) -> str:
    """
    Convert a path from 'git status --porcelain' output to a path relative
    to the git root, in POSIX form.
    """
    abs_path = clutil_resolve_file(git_root / raw_path)
    try:
        return abs_path.relative_to(git_root).as_posix()
    except ValueError:
        return raw_path


def clutil_get_renames() -> dict[str, str]:
    """
    Get the renames staged in the index.

    Returns:
        dict[str, str]: Mapping of new path to old path, both relative to
                        the git root.
    """
    git_root = clutil_get_git_root()
    renames = {}
    for code, new_path, old_path in clutil_get_git_status(
            include_untracked=False):
        if code[:1] == 'R' and old_path is not None:
            renames[clutil_status_path_to_rel(new_path, git_root)] = \
                clutil_status_path_to_rel(old_path, git_root)
    return renames


def clutil_note_split_renames(
        names: list[str], changelists: dict[str, list[str]],
        renames: dict[str, str], git_root: Path) -> list[str]:
    """
    Build a note for each rename where only one of the two paths is in
    the given changelists.

    A rename is only committed as a rename when both the old and the new
    path are committed together. With only one of them in a changelist,
    git cl commit would commit just the addition or just the deletion.

    Args:
        names: Changelist names to check, as one group
        changelists: Loaded changelist data
        renames: Mapping of new path to old path from clutil_get_renames()
        git_root: Repository root

    Returns:
        The note lines, empty if no rename is split.
    """
    files = {path for name in names for path in changelists.get(name, [])}
    cwd = Path.cwd().resolve()
    target = names[0] if len(names) == 1 else None

    def show(path: str) -> str:
        return _relpath(clutil_resolve_file(git_root / path), cwd)

    lines = []
    for new_path, old_path in sorted(renames.items()):
        if (new_path in files) == (old_path in files):
            continue
        if new_path in files:
            present, missing, verb = new_path, old_path, "renamed from"
        else:
            present, missing, verb = old_path, new_path, "renamed to"
        where = (f"changelist '{target}'" if target
                 else "the changelists being committed")
        lines.append(f"Note: '{show(present)}' was {verb} "
                     f"'{show(missing)}', which is not in {where}.")
        if target:
            lines.append(f"      Add it with 'git cl add {target} "
                         f"{show(missing)}' to commit the rename.")
    return lines


def clutil_get_file_status_map(
        include_untracked: bool = True) -> dict[str, str]:
    """
    Get a mapping of files to their Git 2-letter status codes.

    Every status code Git reports is included, as with 'git status'.
    Until 1.6.x, uncommon codes such as type changes ('T ') were left
    out by default. Files in a changelist with such a code were then
    shown with a wrong status, for example 'MD' as missing ('[XX]') or
    ' A' (intent to add) as unchanged ('[  ]').

    Ignored files are not included, since 'git status --porcelain' does
    not list them unless explicitly requested with '--ignored'.

    Args:
        include_untracked (bool): If True (default), list every untracked file.
            If False, untracked files are excluded entirely from the status map.

    Returns:
        dict[str, str]: Mapping of relative file paths
                        to their Git status codes.
    """
    git_root = clutil_get_git_root()
    output = clutil_get_git_status(include_untracked=include_untracked)

    status_map: dict[str, str] = {}

    for code, raw_path, old_path in output:
        # Handle renamed files. In the index the old path is a staged
        # deletion, so record it as 'D ' as well. Otherwise it has no
        # status and looks like a file missing from the branch.
        if code.startswith('R') and old_path is not None:
            old_rel = clutil_status_path_to_rel(old_path, git_root)
            status_map.setdefault(old_rel, 'D ')

        status_map[clutil_status_path_to_rel(raw_path, git_root)] = code

    return status_map


def clutil_format_file_status(
        file: str, status_map: dict[str, str], git_root: Path,
        use_color: bool = True) -> str:
    """
    Format a file's Git status line with optional color-coded output.
    Paths are shown relative to the current working directory.
    """
    abs_file = clutil_resolve_file(git_root / file)
    rel_to_cwd = _relpath(abs_file, Path.cwd().resolve())

    rel_to_git_root = abs_file.relative_to(git_root).as_posix()
    status = status_map.get(rel_to_git_root, "  ")

    # Add detection of files which are deleted (committed) but still
    # included in a changelists
    if (not clutil_path_exists(abs_file) and status == "  "
            and not clutil_is_skip_worktree(abs_file)):
        status = "XX"  # Custom code for missing file
        clutil_print_error(f"Warning: The file '{rel_to_cwd}' does not exist "
                           "and is unknown to Git.\n"
                           "         It may have been deleted and committed, "
                           "exist only on another branch,\n"
                           "         or be in a stash. To remove it from its "
                           f"changelist: git cl rm {shlex.quote(rel_to_cwd)}")

    tag = f"[{status}]"

    if not use_color or not COLORAMA_AVAILABLE:
        return f"  {tag} {rel_to_cwd}"

    staged, unstaged = status[0], status[1]


    CONFLICT_CODES = {'UU', 'AA', 'DD', 'AU', 'UA', 'DU', 'UD'}

    if status in CONFLICT_CODES:
        color = Fore.RED
    elif status == "??":
        color = Fore.BLUE
    elif staged != " " and unstaged == " ":
        color = Fore.GREEN
    elif staged == " " and unstaged != " ":
        color = Fore.RED
    elif staged != " " and unstaged != " ":
        color = Fore.MAGENTA
    else:
        color = Style.RESET_ALL

    return f"{color}  {tag} {rel_to_cwd}{Style.RESET_ALL}"


def clutil_read_commit_message_file(file_path: str) -> str:
    """
    Reads a commit message from a file, with validation and processing.

    Args:
        file_path (str): Path to the file containing the commit message

    Returns:
        str: The commit message content

    Raises:
        OSError: If the file cannot be read
        ValueError: If the file is empty or contains only whitespace
    """
    try:
        # Resolve path relative to current working directory
        path = Path(file_path).resolve()

        # Basic security check - ensure file exists and is readable
        if not path.exists():
            raise OSError(f"File does not exist: {file_path}")

        if not path.is_file():
            raise OSError(f"Path is not a file: {file_path}")

        # Reasonable size limit for commit messages (generous 64KB)
        if path.stat().st_size > 64 * 1024:
            raise ValueError("Commit message file too large (>64KB)")

        # Read the file
        with open(path, 'r', encoding='utf-8') as f:
            content = f.read(64 * 1024)  # Enforce the same limit

    except (OSError, UnicodeDecodeError) as error:
        raise OSError(f"Cannot read file: {error}") from error

    # Validate content
    if not content or not content.strip():
        raise ValueError(
            "Commit message file is empty or contains only whitespace")

    # Process the content similar to how Git does it:
    # - Strip trailing whitespace from each line
    # - Remove trailing empty lines
    lines = [line.rstrip() for line in content.splitlines()]

    # Remove trailing empty lines
    while lines and not lines[-1]:
        lines.pop()

    if not lines:
        raise ValueError(
            "Commit message file contains no content after processing")

    # Join lines back together
    processed_content = '\n'.join(lines)

    return processed_content


def clutil_is_file_untracked_cached(
        file_path_rel_to_git_root: str,
        status_map: dict[str, str]) -> bool:
    """
    Check if a file is untracked using a precomputed status map.

    Looks the path up directly in the status map rather than shelling out
    to `git status` per file, which matters inside loops over changelist
    files. The caller is responsible for obtaining the status map once via
    clutil_get_file_status_map() before the loop.

    Args:
        file_path_rel_to_git_root: File path relative to git repository root
        status_map: Precomputed status map from clutil_get_file_status_map

    Returns:
        True if the file is untracked, False otherwise.
    """
    return status_map.get(file_path_rel_to_git_root, "  ") == "??"


def clutil_detect_merge_conflicts(status_map: dict[str, str]) -> list[str]:
    """
    Return a list of files currently in a merge-conflict (unmerged) state.

    Unmerged status codes per git-status(1):
      UU - both sides modified
      AA - both sides added
      DD - both sides deleted
      AU - added by us, modified by them
      UA - added by them, modified by us
      DU - deleted by us, modified by them
      UD - modified by us, deleted by them

    A file in any of these states cannot be safely staged, committed,
    stashed, or checked out via git-cl while the merge is unresolved.

    Args:
        status_map: Precomputed status map from clutil_get_file_status_map

    Returns:
        Sorted list of file paths (relative to git root) in a conflict state.
    """
    conflict_codes = {'UU', 'AA', 'DD', 'AU', 'UA', 'DU', 'UD'}
    return sorted(path for path, code in status_map.items()
                  if code in conflict_codes)


def clutil_refuse_on_merge_conflict(
        status_map: dict[str, str], operation: str) -> bool:
    """
    Check for merge conflicts and print a refusal message if any are found.

    Used at the top of state-mutating commands (stage, unstage, commit,
    stash, checkout) to bail out cleanly rather than letting git produce
    cryptic errors or leave the repo in an inconsistent state.

    Args:
        status_map: Precomputed status map from clutil_get_file_status_map
        operation: Short verb for the error message (e.g. 'stage', 'commit')

    Returns:
        True if a conflict was detected and the caller should return.
        False if the caller may proceed.
    """
    conflicts = clutil_detect_merge_conflicts(status_map)
    if not conflicts:
        return False

    clutil_print_error(f"Error: Cannot {operation} while merge conflicts are "
                       "unresolved.")
    clutil_print_error("The following files have conflicts:")
    for path in conflicts:
        clutil_print_error(f"  [{status_map[path]}] {path}")
    clutil_print_error("\nResolve conflicts first:")
    clutil_print_error("  1. Edit the files to resolve conflicts")
    clutil_print_error("  2. Mark them as resolved: git add <files>")
    operation_in_progress = clutil_git_operation_in_progress()
    if operation_in_progress == "merge":
        clutil_print_error("  3. Complete the merge: git commit")
        clutil_print_error("\nOr abort the merge: git merge --abort")
    elif operation_in_progress:
        clutil_print_error(f"  3. Continue the {operation_in_progress}, or "
                           "abort it (see 'git status')")
    return True


def clutil_git_operation_in_progress() -> Optional[str]:
    """
    Tell which Git operation, if any, has stopped with conflicts.

    Conflicts can also come from 'git stash apply' or 'git cl unstash',
    which leave no operation to complete or abort. Hints for 'git commit'
    or 'git merge --abort' would be wrong then.

    Returns:
        "merge", "rebase", "cherry-pick" or "revert", or None if no such
        operation is in progress.
    """
    markers = [("MERGE_HEAD", "merge"), ("rebase-merge", "rebase"),
               ("rebase-apply", "rebase"), ("CHERRY_PICK_HEAD", "cherry-pick"),
               ("REVERT_HEAD", "revert")]
    for marker, operation in markers:
        try:
            path = subprocess.run(["git", "rev-parse", "--git-path", marker],
                                  check=True, capture_output=True,
                                  text=True).stdout.strip()
        except subprocess.CalledProcessError:
            return None
        if path and os.path.exists(path):
            return operation
    return None


def clutil_resolve_changelist_names(
        names: list[str], changelists: dict[str, list[str]],
        operation: str) -> Optional[list[str]]:
    """
    Validate changelist names for commands that act on several
    changelists at once (stage, unstage, commit).

    Duplicate names are dropped while preserving the user's order. If any
    name does not exist, an error is printed for each missing name and
    None is returned so that the caller changes nothing at all.

    Args:
        names: Changelist names as given on the command line
        changelists: Loaded changelist data
        operation: Past participle for the abort message (e.g. 'staged')

    Returns:
        The de-duplicated list of names, or None if any name is missing.
    """
    unique_names = list(dict.fromkeys(names))
    missing = [name for name in unique_names if name not in changelists]
    if not missing:
        return unique_names

    for name in missing:
        clutil_print_error(f"Error: Changelist '{name}' not found.")
    if len(unique_names) > 1:
        clutil_print_error(f"Nothing {operation}.")
    return None


def clutil_collect_changelist_files(
        names: list[str], changelists: dict[str, list[str]],
        git_root: Path, status_map: dict[str, str],
        include: Callable[[str], bool]) -> tuple[list[str],
                                                   dict[str, list[str]]]:
    """
    Collect existing files from one or more changelists, as paths relative
    to the current working directory, filtered by a predicate.

    Files that no longer exist are only included if Git reports a status
    for them, i.e. a deletion still to be committed. Files that are gone
    with no Git status (e.g. already committed as deleted) produce a
    warning and are skipped. A file listed in more than one changelist is
    only returned once.

    Args:
        names: Changelist names to collect from
        changelists: Loaded changelist data
        git_root: Repository root
        status_map: Precomputed status map from clutil_get_file_status_map
        include: Called with the stored path (relative to git root);
                 return True to include the file

    Returns:
        A tuple of (all files in order, files grouped by changelist name).
    """
    cwd = Path.cwd().resolve()
    files: list[str] = []
    files_by_name: dict[str, list[str]] = {}

    for name in names:
        files_by_name[name] = []
        for stored_path in changelists[name]:
            abs_path = clutil_resolve_file(git_root / stored_path)

            if not clutil_path_exists(abs_path) and stored_path not in status_map:
                clutil_print_error(f"Warning: '{stored_path}' does not exist.")
                continue

            rel_to_cwd = _relpath(abs_path, cwd)
            if include(stored_path) and rel_to_cwd not in files:
                files.append(rel_to_cwd)
                files_by_name[name].append(rel_to_cwd)

    return files, files_by_name


def clutil_changelist_label(names: list[str]) -> str:
    """
    Format changelist names for messages, e.g. "changelist 'a'" or
    "changelists 'a', 'b'".
    """
    quoted = ", ".join(f"'{name}'" for name in names)
    plural = "s" if len(names) > 1 else ""
    return f"changelist{plural} {quoted}"


def clutil_print_files_by_changelist(
        heading: str, names: list[str], files: list[str],
        files_by_name: dict[str, list[str]]) -> None:
    """
    Print the result of a stage, unstage or commit operation.

    For a single changelist the files are listed directly; for several
    changelists they are grouped by changelist name.

    Args:
        heading: Leading text, e.g. "Staged tracked files from"
        names: Changelist names involved
        files: All files that were processed
        files_by_name: Files grouped by changelist name
    """
    print(f"{heading} {clutil_changelist_label(names)}:")
    if len(names) == 1:
        for file in files:
            print(f"  {file}")
        return

    for name in names:
        print(f"  {name}:")
        if files_by_name[name]:
            for file in files_by_name[name]:
                print(f"    {file}")
        else:
            print("    (no files)")


def clutil_get_stash_file() -> Path:
    """
    Returns the path to the stash metadata file inside the Git directory.

    Returns:
        Path: Path to the '.git/cl-stashes.json' file.
    """
    git_dir = Path(subprocess.check_output(
        ["git", "rev-parse", "--git-dir"],
        stderr=subprocess.DEVNULL,
        text=True
    ).strip())
    return git_dir / "cl-stashes.json"


def clutil_load_stashes() -> dict[str, dict]:
    """
    Loads stash metadata from the 'cl-stashes.json' file.

    Returns:
        dict: A mapping of stashed changelist names to their metadata.

    Raises:
        ClutilLoadError: If the file exists but cannot be used. The reason
            has already been printed.
    """
    stash_file = clutil_get_stash_file()
    lock_file = stash_file.with_suffix('.lock')
    if stash_file.exists():
        with clutil_file_lock(lock_file):
            return clutil_read_json_file(stash_file, clutil_check_stash_data)
    return {}


def clutil_save_stashes(data: dict[str, dict]) -> None:
    """
    Saves the stash metadata to 'cl-stashes.json'.

    Writes are atomic: the data is first written to a temporary file in the
    same directory, then renamed over the target. If the process is
    interrupted mid-write, the original file is left untouched.

    Args:
        data (dict): Mapping of stashed changelist names to metadata.

    Raises:
        ClutilSaveError: If the file cannot be written. The error has
            already been printed.
    """
    stash_file = clutil_get_stash_file()
    lock_file = stash_file.with_suffix('.lock')
    with clutil_file_lock(lock_file):
        tmp_path = None
        try:
            fd, tmp_path = tempfile.mkstemp(
                dir=stash_file.parent,
                prefix='.cl-stashes.json.',
                suffix='.tmp'
            )
            with os.fdopen(fd, 'w', encoding='utf-8') as file_handle:
                json.dump(data, file_handle, indent=2)
            os.replace(tmp_path, stash_file)
            tmp_path = None
        except OSError as error:
            clutil_print_error(f"Error saving stash metadata: {error}")
            raise ClutilSaveError(str(error)) from error
        finally:
            if tmp_path is not None:
                try:
                    os.unlink(tmp_path)
                except OSError:
                    pass


# Git status analysis for unstash conflicts
# Maps (staged_char, unstaged_char) -> (is_conflict, description)
UNSTASH_STATUS_ANALYSIS = {
    ('?', '?'): (True, "untracked file blocking stash restoration"),
    (' ', 'M'): (True, "modified in working directory"),
    (' ', 'D'): (True, "deleted in working directory"),
    ('A', ' '): (False, "staged for addition (safe)"),
    ('M', ' '): (False, "staged modifications (safe)"),
    ('D', ' '): (False, "staged for deletion (safe)"),
    ('R', ' '): (False, "staged rename (safe)"),
    (' ', ' '): (False, "clean (ready for unstash)"),
}


def clutil_analyze_file_status_for_unstash(status: str) -> tuple[bool, str]:
    """
    Analyse a Git status code to determine unstash conflicts.

    Args:
        status: 2-character Git status code

    Returns:
        Tuple of (is_conflict, description)
    """
    if len(status) != 2:
        return False, "unknown status"

    staged, unstaged = status[0], status[1]

    # Check direct lookup first
    if (staged, unstaged) in UNSTASH_STATUS_ANALYSIS:
        return UNSTASH_STATUS_ANALYSIS[(staged, unstaged)]

    # Handle remaining cases with simple logic
    if unstaged in ['M', 'D']:
        if unstaged == 'M':
            conflict_desc = "modified in working directory"
        else:
            conflict_desc = "deleted in working directory"
        return True, conflict_desc

    if staged in ['A', 'M', 'D', 'R']:
        stage_desc = {
            'A': "staged for addition (safe)",
            'M': "staged modifications (safe)",
            'D': "staged for deletion (safe)",
            'R': "staged rename (safe)"
        }
        return False, stage_desc.get(staged, "staged changes (safe)")

    return False, "clean (ready for unstash)"


def clutil_check_unstash_conflicts_optimized(
        files: list[str], git_root: Path) -> tuple[list[str], dict[str, str]]:
    """
    Check for conflicts optimised for the stash-branch-unstash workflow.

    In the intended workflow:
    1. Stash changelists → clean working directory
    2. Create/switch to feature branch
    3. Unstash specific changelist → should be conflict-free

    This function focuses on detecting only the conflicts that actually matter
    in this workflow, rather than being overly conservative.

    Args:
        files: List of file paths relative to git root that were stashed
        git_root: Path to git repository root

    Returns:
        tuple: (real_conflicts, file_status_info) where:
        - real_conflicts: Files that will actually prevent unstashing
        - file_status_info: Dict of file -> status description for user info
    """
    status_map = clutil_get_file_status_map()
    real_conflicts = []
    file_status_info = {}

    for file_path in files:
        abs_path = clutil_resolve_file(git_root / file_path)

        if not clutil_path_exists(abs_path):
            # File doesn't exist - this is actually GOOD for unstashing
            # The stash will restore it without conflict
            file_status_info[file_path] = "missing (will be restored)"
            continue

        rel_to_git_root = abs_path.relative_to(git_root).as_posix()
        status = status_map.get(rel_to_git_root, "  ")

        # Use the lookup table for clean analysis
        is_conflict, description = clutil_analyze_file_status_for_unstash(status)

        if is_conflict:
            real_conflicts.append(file_path)

        file_status_info[file_path] = description

    return real_conflicts, file_status_info


def clutil_suggest_workflow_actions(
        conflicting_files: list[str],
        file_status_info: dict[str, str]) -> None:
    """
    Provide workflow-specific suggestions for resolving conflicts.

    Args:
        conflicting_files: Files that have real conflicts
        file_status_info: Status information for all files
    """
    if not conflicting_files:
        return

    clutil_print_error("Workflow suggestions to resolve conflicts:")

    untracked_conflicts = []
    modified_conflicts = []
    deleted_conflicts = []

    for file_path in conflicting_files:
        status_desc = file_status_info[file_path]
        if "untracked" in status_desc:
            untracked_conflicts.append(file_path)
        elif "modified in working" in status_desc:
            modified_conflicts.append(file_path)
        elif "deleted in working" in status_desc:
            deleted_conflicts.append(file_path)

    if untracked_conflicts:
        clutil_print_error("\n  Untracked files blocking stash restoration:")
        for file_path in untracked_conflicts:
            clutil_print_error(f"    {file_path}")
        clutil_print_error("  → Solution: Move, rename, or delete these untracked "
                           "files")

    if modified_conflicts:
        clutil_print_error("\n  Working directory modifications:")
        for file_path in modified_conflicts:
            clutil_print_error(f"    {file_path}")
        clutil_print_error("  → Solution: Stage/commit these changes or revert them")
        clutil_print_error(f"    git add {' '.join(modified_conflicts)} "
                           "&& git commit -m 'Save current work'")
        clutil_print_error(f"    # OR: git checkout -- {' '.join(modified_conflicts)}")

    if deleted_conflicts:
        clutil_print_error("\n  Files deleted in working directory:")
        for file_path in deleted_conflicts:
            clutil_print_error(f"    {file_path}")
        clutil_print_error("  → Solution: If intentional, stage the deletions;"
                           "if not, restore the files")
        clutil_print_error(f"    git rm {' '.join(deleted_conflicts)} "
                           "&& git commit -m 'Remove files'")
        clutil_print_error("    # OR: git checkout HEAD -- "
                           f"{' '.join(deleted_conflicts)}")


def clutil_get_current_branch() -> Optional[str]:
    """
    Get the name of the current Git branch.

    Returns:
        Branch name or None if not on a branch (detached HEAD)
    """
    try:
        result = subprocess.run(["git", "branch", "--show-current"],
                                capture_output=True, text=True, check=True)
        branch = result.stdout.strip()
        return branch if branch else None
    except subprocess.CalledProcessError:
        return None


@contextmanager
def clutil_safe_stash_context(
        git_root: Path,
        files_for_git: list[str],
        untracked_files_for_git: list[str]) -> Iterator[tuple[list[str],
                                                              list[str]]]:
    """
    Context manager to handle directory changes during stash operations.
    Recalculates file paths relative to git root.

    Args:
        git_root: Path to git repository root
        files_for_git: Original file paths relative to current directory
        untracked_files_for_git: Original untracked file paths
                                 relative to current directory

    Yields:
        tuple[list[str], list[str]]: (files_for_git, untracked_files_for_git)
                                     relative to git root
    """
    original_cwd = Path.cwd().resolve()

    def convert_to_git_root_relative(file_paths: list[str]) -> list[str]:
        """Convert file paths to be relative to git root."""
        result = []
        for file_path in file_paths:
            abs_path = clutil_resolve_file(original_cwd / file_path)
            try:
                git_root_relative = abs_path.relative_to(git_root)
                result.append(git_root_relative.as_posix())
            except ValueError:
                # Path is outside git root - should not happen with validation
                result.append(file_path)
        return result

    # Convert both file lists
    safe_files = convert_to_git_root_relative(files_for_git)
    safe_untracked_files = convert_to_git_root_relative(untracked_files_for_git)

    # Change to git root
    os.chdir(git_root)

    try:
        yield safe_files, safe_untracked_files
    finally:
        # Try to restore original directory
        if original_cwd.exists():
            os.chdir(original_cwd)
        else:
            # Directory was deleted - warn user and stay in git root
            try:
                rel_path = _relpath(original_cwd, git_root)
                print(f"Note: Directory '{rel_path}' was removed by git stash.")
                print("Your shell is still pointing to the deleted directory.")
                print("Please run: cd ..")
            except (ValueError, OSError):
                print("Note: Your working directory was removed by git stash.")
                print("Your shell is still pointing to the deleted directory.")
                print("Please run: cd ..")


def clutil_get_stash_source_branch(stash_data: dict) -> Optional[str]:
    """
    Extract the branch name from stash metadata if stored.

    Args:
        stash_data: Stash metadata dictionary

    Returns:
        Branch name or None if not available
    """
    return stash_data.get('source_branch')


def clutil_create_unique_stash_message(changelist_name: str) -> str:
    """
    Create a unique stash message that includes changelist name and timestamp.
    This helps identify our stashes even when mixed with user-created stashes.

    Args:
        changelist_name: Name of the changelist being stashed

    Returns:
        Unique stash message string
    """
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    return f"git-cl-stash:{changelist_name}:{timestamp}"


def clutil_list_stash_entries() -> Optional[list[tuple[str, str, str]]]:
    """
    List the entries of 'git stash list' with their commit hashes.

    Returns:
        A list of (reference, commit hash, reflog subject) tuples, newest
        first, e.g. ("stash@{0}", "3f2a…", "On main: git-cl-stash:one:…"),
        or None if 'git stash list' fails.
    """
    try:
        output = subprocess.run(
            ["git", "stash", "list", "--format=%gd%x00%H%x00%gs"],
            check=True, capture_output=True, text=True).stdout
    except (subprocess.CalledProcessError, OSError):
        return None
    entries = []
    for line in output.splitlines():
        parts = line.split("\0")
        if len(parts) == 3:
            entries.append((parts[0], parts[1], parts[2]))
    return entries


def clutil_stash_entry_matches(
    entry: tuple[str, str, str],
    record: dict,
    name: str
) -> bool:
    """
    Tell whether a 'git stash list' entry is the stash of a record.

    The stash commit hash recorded when the changelist was stashed
    identifies the stash exactly. Records from earlier versions have no
    hash; for them the full stash message 'git-cl-stash:<name>:<timestamp>'
    is matched, or, for the earliest records without a message, the
    prefix 'git-cl-stash:<name>:'.

    The message alone is not unique: worktrees of one repository share
    the stash list, so a changelist of the same name stashed in another
    worktree within the same second has the same message.

    Args:
        entry: (reference, commit hash, reflog subject) from
            clutil_list_stash_entries()
        record: The stash record from cl-stashes.json
        name: The changelist name the record is stored under

    Returns:
        True if the entry belongs to the record's stash.
    """
    _, commit, subject = entry
    stash_commit = record.get("stash_commit")
    if isinstance(stash_commit, str) and stash_commit:
        return commit == stash_commit
    message = record.get("stash_message")
    if isinstance(message, str) and message:
        return subject.endswith(": " + message)
    return f"git-cl-stash:{name}:" in subject


def clutil_find_stash_ref(record: dict, name: str) -> Optional[str]:
    """
    Find the current reference of a record's stash in 'git stash list'.

    The reference shifts (stash@{0} becomes stash@{1}) whenever another
    stash is pushed, so it is looked up each time.

    Args:
        record: The stash record from cl-stashes.json
        name: The changelist name the record is stored under

    Returns:
        The stash reference (e.g. "stash@{2}") or None if not found
    """
    for entry in clutil_list_stash_entries() or []:
        if clutil_stash_entry_matches(entry, record, name):
            return entry[0]
    return None


def clutil_find_orphaned_stashes(stashes: dict[str, dict]) -> list[str]:
    """
    Find stashed changelists whose Git stash no longer exists.

    A record is orphaned when no entry in 'git stash list' belongs to it
    (see clutil_stash_entry_matches()). This happens when the stash was
    popped or dropped with plain git. Such a record can never be
    unstashed, and its files cannot be added to another changelist.

    Args:
        stashes: Stashed changelists as loaded by clutil_load_stashes()

    Returns:
        Sorted names of orphaned records. Empty if 'git stash list' fails,
        so that a Git error never makes records look orphaned.
    """
    if not stashes:
        return []
    entries = clutil_list_stash_entries()
    if entries is None:
        return []
    return sorted(name for name, record in stashes.items()
                  if not any(clutil_stash_entry_matches(entry, record, name)
                             for entry in entries))


def clutil_print_orphaned_stash_hint(name: str) -> None:
    """Explain that a stash record is orphaned and how to remove it."""
    clutil_print_error(f"The stash of changelist '{name}' no longer exists. "
                       "It was probably popped or")
    clutil_print_error("dropped with plain git. Run 'git cl prune' to remove "
                       "its record.")


def clutil_stash_all_changelists(changelists: dict[str, list[str]],
                                 quiet: bool = False) -> tuple[int, int]:
    """
    Helper function to stash all active changelists.

    Args:
        changelists: Dictionary of active changelists
        quiet: If True, suppress verbose output for workflow contexts

    Returns:
        Tuple of (success_count, total) where total is the number of
        non-empty changelists. Callers must compare the two to detect
        partial failures (see issue #51).
    """
    if not changelists:
        if not quiet:
            print("No active changelists found.")
        return 0, 0

    # Get current branch for tracking
    current_branch = clutil_get_current_branch()

    if not quiet:
        print(f"Stashing all active changelists from branch "
              f"'{current_branch or 'detached HEAD'}':")

    success_count = 0

    # Sort changelists by name for predictable order
    sorted_changelists = sorted(changelists.items())
    total = len([cl for cl, files in sorted_changelists if files])

    for cl_name, files in sorted_changelists:
        if not files:  # Skip empty changelists
            continue

        if not quiet:
            print(f"\n--- Stashing '{cl_name}' ---")

        # Create a temporary args object for individual stash
        temp_args = argparse.Namespace()
        temp_args.name = cl_name
        temp_args.all = False

        try:
            # Call cl_stash with quiet mode. cl_stash reports its own
            # errors and returns False on failure, so only count real
            # successes here (previously every call was counted).
            if cl_stash(temp_args, quiet=quiet):
                success_count += 1
            else:
                clutil_print_error(f"Failed to stash changelist '{cl_name}'.")
        except (OSError, subprocess.CalledProcessError,
                json.JSONDecodeError) as error:
            clutil_print_error(f"Failed to stash '{cl_name}': {error}")
            continue

    if not quiet:
        print(f"\nStashed {success_count}/{total} "
              "changelists successfully.")
        if success_count > 0:
            print("Working directory should now be clean for branch operations.")
            print("Use 'git cl unstash <changelist>' to restore individual "
                  "changelists to feature branches.")

    return success_count, total


def clutil_validate_stash_preconditions(
    name: str,
    changelists: dict[str, list[str]],
    stashes: dict[str, dict]
) -> Optional[str]:
    """
    Validate preconditions for stashing a changelist.

    Args:
        name: Changelist name
        changelists: Active changelists
        stashes: Already stashed changelists

    Returns:
        Error message if validation fails, None if all checks pass
    """
    # Check if changelist is already stashed
    if name in stashes:
        return (f"Error: Changelist '{name}' is already stashed.\n"
                f"Restore it with: git cl unstash {name}")

    # Check if changelist exists
    if name not in changelists:
        return f"Error: Changelist '{name}' not found."

    # Check if changelist is empty
    if not changelists[name]:
        return f"Error: Changelist '{name}' is empty - nothing to stash."

    return None


def clutil_categorize_files_for_stash(
    files: list[tuple[str, Path]],
    missing_files: list[str],
    status_map: dict[str, str],
    git_root: Path
) -> tuple[dict[str, list[str]], list[str], list[str]]:
    """
    Categorize files based on their Git status for stashing.

    Args:
        files: List of (stored_path, abs_path) tuples for existing files
        missing_files: List of paths for non-existent files
        status_map: Git status mapping
        git_root: Git repository root

    Returns:
        Tuple of (file_categories, stashable_files, unstashable_files)
    """
    file_categories: dict[str, list[str]] = {
        'unstaged_changes': [],     # Modified, deleted in working directory
        'staged_additions': [],     # Newly added to index (A_)
        'untracked': [],            # Untracked files (??)
        'deleted_files': [],        # Files that don't exist (potential deletions)
        'clean_files': [],          # Clean files (not stashable)
        'staged_modifications': []  # Files with only staged changes (not stashable)
    }

    stashable_files = []
    unstashable_files = []

    # Process existing files
    for stored_path, abs_path in files:
        rel_to_git_root = abs_path.relative_to(git_root).as_posix()
        status = status_map.get(rel_to_git_root, "  ")
        staged, unstaged = status[0], status[1]

        if status == "??":
            # Untracked files
            # - stashable since they're explicitly in changelist
            file_categories['untracked'].append(stored_path)
            stashable_files.append(stored_path)
        elif unstaged in ['M', 'D']:
            # Unstaged modifications/deletions - stashable
            file_categories['unstaged_changes'].append(stored_path)
            stashable_files.append(stored_path)
        elif staged == 'A' and unstaged == ' ':
            # Newly added to index - stashable
            file_categories['staged_additions'].append(stored_path)
            stashable_files.append(stored_path)
        elif staged in ['M', 'D', 'R'] and unstaged == ' ':
            # Only staged changes - not stashable with git stash push
            file_categories['staged_modifications'].append(stored_path)
            unstashable_files.append(stored_path)
        elif status == "  ":
            # Clean files - not stashable
            file_categories['clean_files'].append(stored_path)
            unstashable_files.append(stored_path)
        else:
            # Mixed staged+unstaged or other complex states
            if unstaged != ' ':
                # Has unstaged component - stashable
                file_categories['unstaged_changes'].append(stored_path)
                stashable_files.append(stored_path)
            else:
                # Only staged component - not stashable
                file_categories['staged_modifications'].append(stored_path)
                unstashable_files.append(stored_path)

    # Process missing files (potential deletions)
    for stored_path in missing_files:
        # Check if this is a deletion by looking at git status
        rel_to_git_root = stored_path  # already relative to git root
        status = status_map.get(rel_to_git_root, "  ")

        if status[1] == 'D':  # Deleted in working directory
            file_categories['deleted_files'].append(stored_path)
            stashable_files.append(stored_path)
        else:
            # File just doesn't exist and git doesn't know about it
            clutil_print_error(f"Warning: File '{stored_path}' "
                               f"does not exist and is not tracked.")
            unstashable_files.append(stored_path)

    return file_categories, stashable_files, unstashable_files


def clutil_report_stash_categorization(
    file_categories: dict[str, list[str]],
    unstashable_files: list[str],
    name: str,
    quiet: bool = False
) -> bool:
    """
    Report file categorization results and check if stash can proceed.

    Args:
        file_categories: Categorized files
        unstashable_files: List of unstashable files
        name: Changelist name
        quiet: If True, suppress verbose output

    Returns:
        True if stash can proceed, False otherwise
    """
    # Report what we found (unless in quiet mode)
    if not quiet:
        if file_categories['unstaged_changes']:
            print(f"Files with unstaged changes: "
                  f"{len(file_categories['unstaged_changes'])}")
        if file_categories['staged_additions']:
            print(f"Newly added files: "
                  f"{len(file_categories['staged_additions'])}")
        if file_categories['untracked']:
            print(f"Untracked files: {len(file_categories['untracked'])}")
        if file_categories['deleted_files']:
            print(f"Deleted files: {len(file_categories['deleted_files'])}")

    # Check for unstashable files and report (always show errors)
    if unstashable_files:
        clutil_print_error(f"\nError: Cannot stash changelist '{name}' "
                           f"because these files are not stashable:")

        if file_categories['clean_files']:
            clutil_print_error("  Clean files (no changes):")
            for file_path in file_categories['clean_files']:
                clutil_print_error(f"    {file_path}")

        if file_categories['staged_modifications']:
            clutil_print_error("  Files with only staged changes "
                               "(use 'git stash --staged' manually if needed):")
            for file_path in file_categories['staged_modifications']:
                clutil_print_error(f"    {file_path}")

        other_unstashable = [f for f in unstashable_files
                             if f not in file_categories['clean_files']
                             and f not in file_categories['staged_modifications']]
        if other_unstashable:
            clutil_print_error("  Other non-stashable files:")
            for file_path in other_unstashable:
                clutil_print_error(f"    {file_path}")

        clutil_print_error("\nStashable files must have:")
        clutil_print_error("  - Unstaged changes (modified/deleted)")
        clutil_print_error("  - Be newly added to index")
        clutil_print_error("  - Be untracked (if explicitly in changelist)")
        return False

    return True


def clutil_prepare_files_for_git_stash(
    stashable_files: list[str],
    file_categories: dict[str, list[str]],
    git_root: Path,
    quiet: bool = False
) -> tuple[list[str], list[str]]:
    """
    Prepare file paths for git stash command.

    Args:
        stashable_files: List of files to stash
        file_categories: Categorized files
        git_root: Git repository root
        quiet: If True, suppress verbose output

    Returns:
        Tuple of (files_for_git, untracked_files_for_git)
    """
    files_for_git = []
    for stored_path in stashable_files:
        abs_path = clutil_resolve_file(git_root / stored_path)
        if clutil_path_exists(abs_path):
            rel_to_cwd = _relpath(abs_path, Path.cwd().resolve())
            files_for_git.append(rel_to_cwd)
        else:
            # For deleted files, we still need to pass the path
            rel_to_cwd = _relpath(git_root / stored_path, Path.cwd().resolve())
            files_for_git.append(rel_to_cwd)

    # Handle untracked files specially
    # - they need to be added to git first for stashing
    untracked_files_for_git = []
    if file_categories['untracked']:
        if not quiet:
            print("Adding untracked files to git temporarily for stashing...")
        for stored_path in file_categories['untracked']:
            abs_path = clutil_resolve_file(git_root / stored_path)
            rel_to_cwd = _relpath(abs_path, Path.cwd().resolve())
            untracked_files_for_git.append(rel_to_cwd)

        try:
            # Add untracked files to git index
            subprocess.run(["git", "add", "--"]
                           + clutil_literal_pathspecs(untracked_files_for_git),
                           check=True)
        except subprocess.CalledProcessError as error:
            clutil_print_error(f"Error adding untracked files: {error}")
            raise

    return files_for_git, untracked_files_for_git


def clutil_execute_git_stash(
    name: str,
    stash_message: str,
    files_for_git: list[str],
    untracked_files_for_git: list[str]
) -> str:
    """
    Execute the git stash command.

    Args:
        name: Changelist name (used to locate the created stash)
        stash_message: Pre-generated unique stash message, shared with the
            metadata save so the two can never diverge across a second boundary
        files_for_git: Files to stash
        untracked_files_for_git: Untracked files that were temporarily added

    Returns:
        The stash reference if successful

    Raises:
        subprocess.CalledProcessError: If stash fails
    """

    try:
        cmd = (["git", "stash", "push", "-m", stash_message, "--"]
               + clutil_literal_pathspecs(files_for_git))
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)

        # Check if anything was actually stashed
        if "No local changes to save" in result.stderr:
            clutil_print_error("Unexpected: No changes were stashed for changelist "
                               f"'{name}'.")
            # If we added untracked files, we should reset them
            if untracked_files_for_git:
                try:
                    subprocess.run(["git", "reset", "HEAD", "--"] +
                                   clutil_literal_pathspecs(
                                       untracked_files_for_git), check=True)
                    clutil_print_error("Reset temporarily added untracked files.")
                except subprocess.CalledProcessError:
                    clutil_print_error("Warning: Could not reset temporarily added "
                                       "untracked files.")
            raise ValueError("No changes were stashed")

    except subprocess.CalledProcessError as error:
        clutil_print_error(f"Error creating stash: {error}")
        if error.stderr:
            clutil_print_error(f"Git error: {error.stderr}")

        # Cleanup: Reset any untracked files we added
        if untracked_files_for_git:
            try:
                subprocess.run(["git", "reset", "HEAD", "--"]
                               + clutil_literal_pathspecs(untracked_files_for_git),
                               check=True)
                clutil_print_error("Reset temporarily added untracked files after "
                                   "stash failure.")
            except subprocess.CalledProcessError:
                clutil_print_error("Warning: Could not reset temporarily added "
                                   "untracked files.")
        raise

    # Find the created stash. It is the newest one, so refs/stash points
    # to it; its commit hash identifies it even if another stash has the
    # same message.
    try:
        stash_commit = subprocess.run(
            ["git", "rev-parse", "--verify", "--quiet", "refs/stash"],
            check=True, capture_output=True, text=True).stdout.strip()
    except subprocess.CalledProcessError:
        stash_commit = ""
    stash_ref = clutil_find_stash_ref(
        {"stash_commit": stash_commit, "stash_message": stash_message}, name)
    if not stash_ref:
        clutil_print_error("Error: Could not locate the created stash.")
        clutil_print_error("Look for a stash with message containing "
                           f"'git-cl-stash:{name}:'")
        raise ValueError("Could not locate stash")

    return stash_ref


def clutil_build_stash_metadata(
    stash_message: str,
    stash_ref: str,
    files: list[str],
    file_categories: dict[str, list[str]],
    current_branch: Optional[str]
) -> dict:
    """
    Build stash metadata dictionary.

    Args:
        stash_message: Pre-generated unique stash message — the same string
            passed to `git stash push`, so metadata and git never diverge
        stash_ref: Git stash reference
        files: Files in the changelist
        file_categories: Categorized files
        current_branch: Current Git branch

    Returns:
        Dictionary containing stash metadata. 'stash_commit' is the commit
        hash of the stash, which identifies it exactly; it is left out if
        it cannot be determined.
    """
    try:
        stash_commit = subprocess.run(
            ["git", "rev-parse", "--verify", "--quiet", stash_ref],
            check=True, capture_output=True, text=True).stdout.strip()
    except subprocess.CalledProcessError:
        stash_commit = ""
    metadata = {
        "stash_ref": stash_ref,
        "stash_message": stash_message,
        "files": files.copy(),
        "timestamp": datetime.datetime.now().isoformat(),
        "source_branch": current_branch,
        "file_categories": {
            "unstaged_changes": file_categories['unstaged_changes'],
            "staged_additions": file_categories['staged_additions'],
            "untracked": file_categories['untracked'],
            "deleted_files": file_categories['deleted_files']
        }
    }
    if stash_commit:
        metadata["stash_commit"] = stash_commit
    return metadata


# pylint: disable-next=too-many-arguments
def clutil_save_stash_metadata_atomic(
    name: str,
    stash_message: str,
    stash_ref: str,
    files: list[str],
    file_categories: dict[str, list[str]],
    changelists: dict[str, list[str]],
    stashes: dict[str, dict]
) -> None:
    """
    Atomically save stash metadata and update changelists.

    The stash metadata is written first, then the changelist is removed
    from 'cl.json'. If the second write fails, the stash entry is removed
    again, so that on failure both files are left as they were.

    Args:
        name: Changelist name
        stash_message: Pre-generated unique stash message (shared with the
            git stash push call)
        stash_ref: Git stash reference
        files: Files in the changelist
        file_categories: Categorized files
        changelists: Active changelists (will be modified)
        stashes: Stashed changelists (will be modified)

    Raises:
        ClutilSaveError: If either file cannot be written.
    """
    current_branch = clutil_get_current_branch()

    # Build stash metadata
    stash_metadata = clutil_build_stash_metadata(
        stash_message, stash_ref, files, file_categories, current_branch
    )

    # Save stash metadata. If this fails, nothing has been written yet.
    stashes[name] = stash_metadata
    try:
        clutil_save_stashes(stashes)
    except ClutilSaveError:
        del stashes[name]
        raise

    # Remove changelist from active changelists
    files_in_changelist = changelists.pop(name)
    try:
        clutil_save(changelists)
    except ClutilSaveError:
        changelists[name] = files_in_changelist
        del stashes[name]
        try:
            clutil_save_stashes(stashes)
        except ClutilSaveError:
            clutil_print_error(f"Warning: Could not remove the stash entry for "
                               f"'{name}' from the stash metadata.")
        raise


def clutil_restore_index_from_stash(
    stash_ref: str,
    files: list[str],
    untracked_files: list[str],
    git_root: Path
) -> list[str]:
    """
    Restore the staged part of stashed files after 'git stash apply'.

    Applying a stash without --index leaves all changes unstaged, except
    new files, which are staged. 'git stash apply --index' cannot be used
    instead: a stash limited to some paths still records the whole index,
    so it fails as soon as files outside the changelist are staged as new
    files. This function therefore restores the index per file:

    - Files whose index differed from HEAD when they were stashed get
      their index entry back from the stash's index commit (<stash>^2).
      This is only done if the file is unchanged between the commit the
      stash was made on (<stash>^1) and the current HEAD. Otherwise the
      staged content would belong to another base, and the file is left
      unstaged.
    - Files that were untracked before stashing had to be added to the
      index temporarily. They are unstaged again.

    Args:
        stash_ref: Git stash reference, not yet dropped
        files: Files of the changelist, relative to the Git root
        untracked_files: Files that were untracked when stashed,
            relative to the Git root
        git_root: Path to the Git repository root

    Returns:
        list[str]: Files whose staged changes could not be restored and
            are now unstaged. Empty if all were restored.

    Raises:
        subprocess.CalledProcessError: If a Git command fails.
    """
    git = ["git", "-C", str(git_root)]
    untracked = set(untracked_files)

    staged = subprocess.run(
        git + ["diff", "--name-only", "-z", "--no-renames",
               f"{stash_ref}^1", f"{stash_ref}^2", "--"]
        + clutil_literal_pathspecs(files),
        check=True, capture_output=True, text=True).stdout
    staged_files = [f for f in staged.split("\0") if f and f not in untracked]

    def blob(revision: str, path: str) -> Optional[str]:
        result = subprocess.run(git + ["rev-parse", "--verify", "--quiet",
                                       f"{revision}:{path}"],
                                capture_output=True, text=True, check=False)
        return result.stdout.strip() if result.returncode == 0 else None

    to_restore = []
    not_restored = []
    for path in staged_files:
        if blob(f"{stash_ref}^1", path) == blob("HEAD", path):
            to_restore.append(path)
        else:
            not_restored.append(path)

    if to_restore:
        subprocess.run(git + ["reset", "--quiet", f"{stash_ref}^2", "--"]
                       + clutil_literal_pathspecs(to_restore),
                       check=True, capture_output=True, text=True)

    still_staged = [f for f in untracked_files
                    if (git_root / f).exists() or (git_root / f).is_symlink()]
    if still_staged:
        subprocess.run(git + ["reset", "--quiet", "--"]
                       + clutil_literal_pathspecs(still_staged),
                       check=True, capture_output=True, text=True)

    return not_restored


def clutil_restore_failed_stash(
    stash_ref: str,
    stashed_files: list[str],
    untracked_files: list[str],
    git_root: Path
) -> bool:
    """
    Restore the changes of a stash whose metadata could not be saved.

    Applies the stash, restores the staged part of its files with
    clutil_restore_index_from_stash() and drops it only once its changes
    are back.

    Args:
        stash_ref: Git stash reference created moments before
        stashed_files: Files passed to git stash, relative to the Git root
        untracked_files: Temporarily added files, relative to the Git root
        git_root: Path to the Git repository root

    Returns:
        True if the changes were restored, False if they remain in the stash.
    """
    git = ["git", "-C", str(git_root)]
    try:
        subprocess.run(git + ["stash", "apply", "--quiet", stash_ref],
                       check=True, capture_output=True, text=True)
    except subprocess.CalledProcessError:
        return False

    try:
        clutil_restore_index_from_stash(stash_ref, stashed_files,
                                        untracked_files, git_root)
    except subprocess.CalledProcessError:
        clutil_print_error("Warning: Your changes are back, but which of them "
                           "are staged may differ from before.")

    try:
        subprocess.run(git + ["stash", "drop", "--quiet", stash_ref],
                       check=True, capture_output=True, text=True)
    except subprocess.CalledProcessError:
        clutil_print_error(f"Warning: Could not drop {stash_ref}; its changes "
                           "are already restored.")
    return True


def clutil_handle_stash_failure(
    name: str,
    stash_ref: str,
    stash_message: str,
    stashed_files: list[str],
    untracked_files: list[str],
    git_root: Path
) -> None:
    """
    Handle a failed stash metadata save by restoring the stashed changes.

    By the time the metadata is saved, git stash has already removed the
    changes from the working directory, so the stash must be applied, not
    just dropped. The metadata itself needs no rollback here, because
    clutil_save_stash_metadata_atomic leaves both files unchanged when it
    fails.

    Args:
        name: Changelist name
        stash_ref: Git stash reference
        stash_message: Message of the stash, to help the user find it
        stashed_files: Files passed to git stash, relative to the Git root
        untracked_files: Temporarily added files, relative to the Git root
        git_root: Path to the Git repository root
    """
    clutil_print_error(f"Error: Could not save the stash of changelist '{name}'.")

    if clutil_restore_failed_stash(stash_ref, stashed_files, untracked_files,
                                   git_root):
        clutil_print_error(f"Your changes have been restored. Changelist '{name}' "
                           "remains active.")
    else:
        clutil_print_error("Your changes could not be restored automatically. "
                           "They are kept in")
        clutil_print_error(f"  {stash_ref} ({stash_message})")
        clutil_print_error(f"Restore them with: git stash pop {stash_ref}")
        if untracked_files:
            clutil_print_error("Previously untracked files will then be staged. "
                               "Unstage them with:")
            clutil_print_error("  git restore --staged -- "
                               + " ".join(untracked_files))


def clutil_unstash_all_changelists(
    stashes: dict[str, dict],
    force: bool = False
) -> tuple[int, int]:
    """
    Helper function to unstash all stashed changelists.

    Args:
        stashes: Dictionary of stashed changelists
        force: Whether to force unstash despite conflicts

    Returns:
        Tuple of (success_count, total). Callers must compare the two
        to detect partial failures.
    """
    if not stashes:
        print("No stashed changelists found.")
        return 0, 0

    current_branch = clutil_get_current_branch()
    if not current_branch:
        clutil_print_error("Error: Cannot unstash --all while in detached HEAD state.")
        clutil_print_error("Switch to a branch first: git checkout -b <branch-name>")
        return 0, len(stashes)

    print(f"Unstashing all changelists to branch '{current_branch}':")
    success_count = 0

    # Sort by timestamp (oldest first) for predictable order
    stash_items = list(stashes.items())
    stash_items.sort(key=lambda x: x[1].get('timestamp', ''))

    for stash_name, _ in stash_items:
        print(f"\n--- Unstashing '{stash_name}' ---")
        # Create a temporary args object for individual unstash
        temp_args = argparse.Namespace()
        temp_args.name = stash_name
        temp_args.force = force
        temp_args.all = False

        try:
            # Note: cl_unstash is called later in the module. It reports
            # its own errors and returns False on failure, so only count
            # real successes here.
            if cl_unstash(temp_args):
                success_count += 1
            else:
                clutil_print_error(f"Failed to unstash changelist '{stash_name}'.")
        except (OSError,
                subprocess.CalledProcessError, json.JSONDecodeError) as error:
            clutil_print_error(f"Failed to unstash '{stash_name}': {error}")
            continue

    print(f"\nUnstashed {success_count}/{len(stash_items)} "
          f"changelists successfully.")
    return success_count, len(stash_items)


def clutil_validate_unstash_preconditions(
    base_name: str,
    stash_key: str,
    stashes: dict[str, dict],
    changelists: dict[str, list[str]]
) -> Optional[str]:
    """
    Validate preconditions for unstashing a changelist.

    Args:
        base_name: The base changelist name
        stash_key: The key in stashes dictionary
        stashes: Dictionary of stashed changelists
        changelists: Dictionary of active changelists

    Returns:
        Error message if validation fails, None if all checks pass
    """
    if stash_key not in stashes:
        error_msg = f"Error: No stashed changelist found for '{base_name}'."
        available = list(stashes.keys())
        if available:
            error_msg += "\nAvailable stashed changelists:"
            for stashed_name in available:
                error_msg += f"\n  {stashed_name}"
        return error_msg

    # Check if target changelist name already exists
    if base_name in changelists and changelists[base_name]:
        return (f"Error: Changelist '{base_name}' already exists with files.\n"
                "Please delete or rename the existing changelist first.")

    return None


def clutil_check_branch_workflow(
    base_name: str,
    source_branch: Optional[str],
    force: bool,
    ignore_untracked: bool = False
) -> Optional[str]:
    """
    Check branch workflow requirements for unstashing.

    Args:
        base_name: The changelist name
        source_branch: The branch where changelist was stashed from
        force: Whether to force unstash despite warnings
        ignore_untracked: Whether untracked files may be present in an
            otherwise clean working directory. 'git cl br' sets this:
            untracked files outside any changelist are never stashed, so
            they follow the switch to the new branch, as with
            'git checkout -b'.

    Returns:
        Error message if check fails, None if checks pass
    """
    if force:
        return None

    current_branch = clutil_get_current_branch()

    if not current_branch:
        operation = clutil_git_operation_in_progress()
        if operation:
            return (f"Error: Cannot unstash while a {operation} is in "
                    "progress.\n"
                    f"Finish or abort the {operation} first (see 'git "
                    "status'), then unstash.\n"
                    f"Or use --force to unstash anyway: git cl unstash "
                    f"{base_name} --force")
        return ("Error: Cannot unstash while in detached HEAD state.\n"
                "Create a new branch first: git checkout -b feature-branch\n"
                f"Or use --force to unstash anyway: git cl unstash {base_name} --force")

    # Allow restoring to original branch, but encourage new branches
    if source_branch and current_branch == source_branch:
        print(f"Note: Unstashing '{base_name}' back to original branch "
              f"'{current_branch}'")
        print("This is allowed but consider using a new branch for feature work.")
    else:
        # Check if working directory is clean (recommended for branch
        # workflow). Uncommitted changes inside a submodule belong to the
        # submodule's own repository and are ignored.
        status_cmd = ["git", "status", "--porcelain",
                      "--ignore-submodules=dirty"]
        if ignore_untracked:
            status_cmd.append("--untracked-files=no")
        try:
            git_status = subprocess.run(status_cmd,
                                        capture_output=True, text=True, check=True)
            if git_status.stdout.strip():
                return ("Error: Working directory is not clean on branch "
                        f"'{current_branch}'\n"
                        "The branch workflow works best with a clean working "
                        "directory.\n"
                        "Consider committing or stashing current changes first.\n"
                        "Or use --force to unstash anyway: git cl unstash "
                        f"{base_name} --force")
        except subprocess.CalledProcessError:
            pass  # git status failed, continue anyway

    return None


def clutil_check_and_report_conflicts(
    files: list[str],
    git_root: Path,
    base_name: str,
    force: bool,
    quiet: bool = False
) -> bool:
    """
    Check for conflicts and report them to user.

    Args:
        files: List of files to unstash
        git_root: Git repository root
        base_name: Changelist name
        force: Whether to force despite conflicts
        quiet: If True, suppress verbose output

    Returns:
        True if unstash can proceed, False otherwise
    """
    if force:
        return True

    real_conflicts, file_status_info = (
        clutil_check_unstash_conflicts_optimized(files, git_root))

    if real_conflicts:
        clutil_print_error(f"Error: Cannot unstash '{base_name}' due to conflicts:")
        for file_path in real_conflicts:
            status_desc = file_status_info[file_path]
            clutil_print_error(f"  {file_path} ({status_desc})")

        clutil_suggest_workflow_actions(real_conflicts, file_status_info)
        clutil_print_error("\nAfter resolving conflicts, retry: git cl unstash "
                           f"{base_name}")
        clutil_print_error("Or use --force to attempt automatic merge: "
                           f"git cl unstash {base_name} --force")
        return False

    # Show informational status for non-conflicting files (unless quiet)
    if not quiet:
        safe_files = [f for f in files if f not in real_conflicts]
        if safe_files:
            staged_files = []
            clean_files = []
            missing_files = []
            for file_path in safe_files:
                status_desc = file_status_info.get(file_path, "")
                if "staged" in status_desc:
                    staged_files.append(file_path)
                elif "clean" in status_desc:
                    clean_files.append(file_path)
                elif "missing" in status_desc:
                    missing_files.append(file_path)

            status_summary = []
            if clean_files:
                status_summary.append(f"{len(clean_files)} unchanged in the "
                                      "working directory")
            if missing_files:
                status_summary.append(f"{len(missing_files)} to be restored")
            if staged_files:
                status_summary.append(f"{len(staged_files)} with staged changes")

            if status_summary:
                print(f"Ready to unstash "
                      f"{clutil_plural(len(safe_files), 'file')}: "
                      f"{', '.join(status_summary)}")

    return True


def clutil_verify_and_update_stash_ref(
    base_name: str,
    old_stash_ref: str,
    stash_data: dict
) -> Optional[str]:
    """
    Verify stash still exists and update reference if needed.

    Checks if the stash for the given changelist still exists and updates
    the stash reference if it has changed (due to other stash operations).
    The updated reference is persisted to the stash metadata file to prevent
    future reference drift.

    Args:
        base_name: Changelist name
        old_stash_ref: Previously stored stash reference
        stash_data: The stash record, used to find the stash

    Returns:
        Updated stash reference or None if stash doesn't exist
    """
    current_stash_ref = clutil_find_stash_ref(stash_data, base_name)

    if not current_stash_ref:
        clutil_print_error(f"Error: Stash for changelist '{base_name}' no longer "
                           "exists.")
        clutil_print_error("The stash may have been manually dropped. Available "
                           "stashes:")
        try:
            stash_list = subprocess.check_output(["git", "stash", "list"],
                                                 text=True)
            if stash_list.strip():
                for line in stash_list.strip().split('\n'):
                    clutil_print_error(f"  {line}")
            else:
                clutil_print_error("  (no stashes found)")
        except subprocess.CalledProcessError:
            clutil_print_error("  (could not list stashes)")
        clutil_print_error("Run 'git cl prune' to remove its record.")
        return None

    # Update stash reference if needed
    if current_stash_ref != old_stash_ref:
        print(f"Note: Stash reference updated from {old_stash_ref} "
              f"to {current_stash_ref}")

        # Persist the updated reference to prevent future drift
        stashes = clutil_load_stashes()
        if base_name in stashes:
            stashes[base_name]["stash_ref"] = current_stash_ref
            clutil_save_stashes(stashes)

    return current_stash_ref


def clutil_report_unstash_conflicts(stash_ref: str, base_name: str) -> None:
    """
    Explain what to do after 'git stash apply' stopped with conflicts.

    Args:
        stash_ref: Git stash reference, which is kept
        base_name: Changelist name
    """
    try:
        conflicted = subprocess.run(
            ["git", "diff", "--name-only", "--diff-filter=U", "-z"],
            check=True, capture_output=True, text=True).stdout.split("\0")
    except subprocess.CalledProcessError:
        conflicted = []
    git_root = clutil_get_git_root()
    cwd = Path.cwd().resolve()
    conflicted = [_relpath(git_root / f, cwd) for f in conflicted if f]

    clutil_print_error(f"Error: Unstashing '{base_name}' stopped with "
                       "conflicts in:")
    for path in conflicted:
        clutil_print_error(f"  {path}")
    clutil_print_error(f"Changelist '{base_name}' is restored, and its changes "
                       "are in the working directory,")
    clutil_print_error("with conflict markers in the files above. Edit them, "
                       "then mark them as resolved:")
    clutil_print_error("  git add " + " ".join(shlex.quote(p) for p in conflicted)
                       if conflicted else "  git add <files>")
    clutil_print_error(f"The stash is kept as {stash_ref} in case you need it. "
                       "Once you are done:")
    clutil_print_error(f"  git stash drop {stash_ref}")


def clutil_apply_stash(
    stash_ref: str,
    base_name: str,
    stash_data: dict,
    quiet: bool = False
) -> str:
    """
    Restore a stashed changelist, including which changes were staged.

    Applies the stash, restores the staged part of its files with
    clutil_restore_index_from_stash() and then drops the stash.

    If applying stops with conflicts, the changes are in the working
    directory with conflict markers, as with 'git stash pop'. The stash
    is kept in case the user needs it again, and the caller restores the
    changelist, because unstashing again would apply the changes twice.
    If the stash cannot be applied at all, nothing changes.

    Args:
        stash_ref: Git stash reference
        base_name: Changelist name for messages
        stash_data: Stash metadata with 'files' and 'file_categories'
        quiet: If True, suppress verbose output

    Returns:
        "applied" on success, "conflict" if the changes were applied with
        conflicts, "failed" if nothing was applied.
    """
    if not quiet:
        current_branch = clutil_get_current_branch()
        branch_info = f" to branch '{current_branch}'" if current_branch else ""
        print(f"Unstashing changelist '{base_name}'{branch_info}...")

    try:
        subprocess.run(["git", "stash", "apply", stash_ref],
                       capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as error:
        git_output = f"{error.stdout or ''}\n{error.stderr or ''}"
        if "CONFLICT" in git_output:
            clutil_report_unstash_conflicts(stash_ref, base_name)
            return "conflict"
        clutil_print_error(f"Error: Cannot unstash '{base_name}'. Git reports:")
        for line in (error.stderr or error.stdout or "").strip().splitlines():
            clutil_print_error(f"  {line}")
        clutil_print_error(f"The stash is kept as {stash_ref}.")
        return "failed"

    git_root = clutil_get_git_root()
    untracked_files = stash_data.get("file_categories", {}).get("untracked", [])
    try:
        not_restored = clutil_restore_index_from_stash(
            stash_ref, stash_data["files"], untracked_files, git_root)
        if not_restored:
            clutil_print_error("Note: These files changed on this branch since "
                               "they were stashed.")
            clutil_print_error("Their staged changes could not be restored "
                               "and are now unstaged:")
            for path in not_restored:
                clutil_print_error(f"  {path}")
    except subprocess.CalledProcessError:
        clutil_print_error("Warning: Your changes are back, but which of them "
                           "are staged may differ from before.")

    try:
        subprocess.run(["git", "stash", "drop", "--quiet", stash_ref],
                       check=True, capture_output=True, text=True)
    except subprocess.CalledProcessError:
        clutil_print_error(f"Warning: Could not drop {stash_ref}; its changes "
                           "are already restored.")
    return "applied"


def clutil_process_unstash_result(
    base_name: str,
    files: list[str],
    current_branch: Optional[str]
) -> None:
    """
    Process and display results after successful unstash.

    Args:
        base_name: Changelist name
        files: List of files that were restored
        current_branch: Current Git branch
    """
    success_msg = f"  Successfully unstashed changelist '{base_name}'"
    if current_branch:
        success_msg += f" to branch '{current_branch}'"
    print(success_msg)
    print(f"  Restored {clutil_plural(len(files), 'file')} to working directory")
    print("  Ready to work on your feature!")

    # Show the files that were restored
    if len(files) <= 10:
        print("Files restored:")
        for file_path in files:
            print(f"  {file_path}")
    else:
        print(f"Files restored: {files[0]}, {files[1]}, "
              f"... and {len(files) - 2} others")


def clutil_update_unstash_metadata(
    base_name: str,
    stash_key: str,
    files: list[str],
    changelists: dict[str, list[str]],
    stashes: dict[str, dict],
    quiet: bool = False
) -> bool:
    """
    Update metadata after successful unstash.

    The stash entry is removed first. If restoring the changelist fails
    afterwards, the files are back in the working directory and only the
    changelist has to be recreated, which the warning explains.

    Args:
        base_name: Changelist name
        stash_key: Key in stashes dictionary
        files: List of files in the changelist
        changelists: Active changelists dictionary (will be modified)
        stashes: Stashed changelists dictionary (will be modified)
        quiet: If True, suppress verbose output

    Returns:
        True if the metadata was updated, False otherwise.
    """
    try:
        del stashes[stash_key]
        clutil_save_stashes(stashes)

        changelists[base_name] = files.copy()
        clutil_save(changelists)

    except (OSError, subprocess.CalledProcessError,
            json.JSONDecodeError) as metadata_error:
        clutil_print_error(f"Warning: Unstash succeeded but metadata update failed: "
                           f"{metadata_error}")
        clutil_print_error(f"Manually recreate the changelist: git cl add "
                           f"{base_name} <files>")
        return False

    if not quiet:
        current_branch = clutil_get_current_branch()
        clutil_process_unstash_result(base_name, files, current_branch)
    return True


def clutil_prepare_stash_files(
    files: list[str],
    git_root: Path
) -> tuple[list[tuple[str, Path]], list[str]]:
    """
    Prepare files for stashing by checking existence.

    Args:
        files: List of file paths from changelist
        git_root: Git repository root

    Returns:
        Tuple of (existing_files, missing_files)
    """
    missing_files = []
    existing_files = []

    for stored_path in files:
        abs_path = clutil_resolve_file(git_root / stored_path)
        if not clutil_path_exists(abs_path):
            missing_files.append(stored_path)
        else:
            existing_files.append((stored_path, abs_path))

    return existing_files, missing_files


def clutil_print_stash_success(
    name: str,
    stashable_files: list[str],
    file_categories: dict[str, list[str]],
    current_branch: Optional[str]
) -> None:
    """
    Print success message after stashing.

    Args:
        name: Changelist name
        stashable_files: List of files that were stashed
        file_categories: Categorized files
        current_branch: Current Git branch
    """
    success_msg = f"  Successfully stashed changelist '{name}'"
    if current_branch:
        success_msg += f" from branch '{current_branch}'"
    print(success_msg)
    print(f"  Stashed {clutil_plural(len(stashable_files), 'file')}:")

    # Show breakdown of what was stashed
    categories_to_show = {
        'unstaged_changes': 'with unstaged changes',
        'staged_additions': 'newly added',
        'untracked': 'untracked',
        'deleted_files': 'deleted'
    }

    for category_key, category_display in categories_to_show.items():
        files_list = file_categories.get(category_key, [])
        if files_list:
            print(f"    {len(files_list)} {category_display}")

    print("  Working directory is now clean for this changelist")


def clutil_show_active_changelists(
    changelists: dict[str, list[str]],
    selected_names: Optional[set[str]],
    status_map: dict[str, str],
    git_root: Path,
    use_color: bool
) -> tuple[bool, set[str]]:
    """
    Display active changelists and return assigned files.

    Args:
        changelists: Active changelists
        selected_names: Set of names to filter by (None = show all)
        status_map: Git status mapping
        git_root: Git repository root
        use_color: Whether to use coloured output

    Returns:
        Tuple of (shown_any, assigned_files)
    """
    assigned_files = set()
    shown_any = False

    for cl_name, files in changelists.items():
        for f in files:
            try:
                abs_path = clutil_resolve_file(git_root / f)
                assigned_files.add(abs_path.relative_to(git_root).as_posix())
            except (ValueError, OSError) as error:
                clutil_print_error(f"Error resolving path: {error}")

        if selected_names is not None and cl_name not in selected_names:
            continue

        if files:
            print(f"{cl_name}:")
            shown_any = True
            for file in files:
                print(clutil_format_file_status(file, status_map, git_root, use_color))

    return shown_any, assigned_files


def clutil_show_stashed_changelists(stashes: dict[str, dict]) -> None:
    """
    Display stashed changelists section.

    Args:
        stashes: Dictionary of stashed changelists
    """
    print("Stashed Changelists:")

    # Sort by timestamp (most recent first)
    stashed_items = []
    for stash_name, stash_data in stashes.items():
        timestamp = stash_data.get('timestamp', '')
        file_count = len(stash_data.get('files', []))
        stashed_items.append((stash_name, file_count, timestamp))

    # Sort by timestamp descending (most recent first)
    stashed_items.sort(key=lambda x: x[2], reverse=True)

    for stash_name, file_count, timestamp in stashed_items:
        # Format timestamp for display
        try:
            dt = datetime.datetime.fromisoformat(timestamp)
            formatted_time = dt.strftime("%Y-%m-%d %H:%M")
        except (ValueError, AttributeError):
            formatted_time = "unknown time"

        file_word = "file" if file_count == 1 else "files"
        print(f"  {stash_name} ({file_count} {file_word}, {formatted_time})")


def clutil_validate_unstash_environment(
    base_name: str,
    stash_key: str,
    stashes: dict[str, dict],
    changelists: dict[str, list[str]],
    force: bool,
    ignore_untracked: bool = False
) -> tuple[Optional[str], Optional[dict]]:
    """
    Validate all preconditions for unstashing.

    Args:
        base_name: Base changelist name
        stash_key: Key in stashes dictionary
        stashes: Stashed changelists
        changelists: Active changelists
        force: Whether to force despite warnings
        ignore_untracked: Whether untracked files are allowed in the
            clean working directory check

    Returns:
        Tuple of (error_message, stash_data) - error_message is None if valid
    """
    # Validate basic preconditions
    error_msg = clutil_validate_unstash_preconditions(
        base_name, stash_key, stashes, changelists
    )
    if error_msg:
        return error_msg, None

    stash_data = stashes[stash_key]
    source_branch = clutil_get_stash_source_branch(stash_data)

    # Check branch workflow requirements
    error_msg = clutil_check_branch_workflow(base_name, source_branch, force,
                                             ignore_untracked)
    if error_msg:
        return error_msg, None

    return None, stash_data


