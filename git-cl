# BRANCH WORKFLOW UTILITIES (branch-specific utilities)
# =============================================================================

def clutil_validate_branch_preconditions(
        changelist_name: str, changelists: dict, stashes: dict) -> str:
    """Validate preconditions for branch creation workflow."""
    if changelist_name in stashes and changelist_name not in changelists:
        return (f"Error: Changelist '{changelist_name}' is stashed.\n"
                f"Unstash it first with 'git cl unstash {changelist_name}', "
                "then run git cl branch again.")

    if changelist_name not in changelists:
        error_msg = f"Error: Changelist '{changelist_name}' not found."
        available = [name for name in changelists.keys() if changelists[name]]
        if available:
            error_msg += "\nAvailable active changelists:"
            for name in available:
                error_msg += f"\n  {name}"
        return error_msg

    if not changelists[changelist_name]:
        return (f"Error: Changelist '{changelist_name}' is empty.\n"
                f"Add files with: git cl add {changelist_name} <files>")

    if changelist_name in stashes:
        return (f"Error: Changelist '{changelist_name}' is already stashed.\n"
                f"Use 'git cl unstash {changelist_name}' to restore it first.")

    return ""


def clutil_check_branch_exists(branch_name: str) -> bool:
    """Check if a branch already exists."""
    try:
        result = subprocess.run(["git", "show-ref", "--verify",
                                 f"refs/heads/{branch_name}"],
                                capture_output=True, text=True, check=False)
        return result.returncode == 0
    except subprocess.CalledProcessError:
        return False


def clutil_get_submodule_paths(git_root: Path) -> list[str]:
    """
    Return the paths of all submodules, relative to the Git root.

    A submodule is recorded in the index as a 'gitlink' (mode 160000): a
    pointer to a commit of another repository, not a file. Changelists
    contain files only, so submodules are kept out of them, just like
    directories.

    Args:
        git_root: Path to the Git repository root

    Returns:
        Submodule paths, e.g. ["libs/sub"]. Empty if there are none or
        Git fails.
    """
    try:
        output = subprocess.run(
            ["git", "-C", str(git_root), "ls-files", "--stage", "-z"],
            check=True, capture_output=True, text=True).stdout
    except subprocess.CalledProcessError:
        return []
    paths = []
    for entry in output.split("\0"):
        info, _, path = entry.partition("\t")
        if path and info.startswith("160000 "):
            paths.append(path)
    return paths


def clutil_find_submodule(path: str, submodules: list[str]) -> Optional[str]:
    """
    Return the submodule that is or contains a path, if any.

    Args:
        path: Path relative to the Git root
        submodules: Paths from clutil_get_submodule_paths()

    Returns:
        The submodule path, or None if the path is not in a submodule.
    """
    for submodule in submodules:
        if path == submodule or path.startswith(submodule + "/"):
            return submodule
    return None


def clutil_get_changed_submodule_pointers(
    git_root: Path,
    submodules: list[str]
) -> set[str]:
    """
    Return the submodules whose recorded commit differs from HEAD.

    Changes inside a submodule that are not committed there belong to the
    submodule's own repository and are ignored ('--ignore-submodules=
    dirty'). A new commit in the submodule changes the pointer in this
    repository, which is a change here.

    Args:
        git_root: Path to the Git repository root
        submodules: Paths from clutil_get_submodule_paths()

    Returns:
        Submodule paths whose pointer changed in the index or working
        directory. If Git fails, all submodules are returned, so that no
        change is overlooked.
    """
    if not submodules:
        return set()
    try:
        output = subprocess.run(
            ["git", "-C", str(git_root), "diff", "HEAD", "--name-only", "-z",
             "--ignore-submodules=dirty", "--"]
            + clutil_literal_pathspecs(submodules),
            check=True, capture_output=True, text=True).stdout
    except subprocess.CalledProcessError:
        return set(submodules)
    return {path for path in output.split("\0") if path}


def clutil_check_unassigned_changes(changelists: dict,
                                    git_root: Path) -> list[str]:
    """
    Check for uncommitted changes not in any changelist.

    Untracked files are ignored, and so are submodules with uncommitted
    changes of their own. A submodule whose recorded commit changed is
    reported, because the change would move to a new branch unnoticed.
    """
    status_map = clutil_get_file_status_map()

    # Get all files assigned to changelists
    assigned_files = set()
    for files in changelists.values():
        for file_path in files:
            try:
                abs_path = clutil_resolve_file(git_root / file_path)
                rel_path = abs_path.relative_to(git_root).as_posix()
                assigned_files.add(rel_path)
            except (ValueError, OSError):
                continue

    # Submodules whose own files changed, but whose recorded commit did
    # not, have no change in this repository
    submodules = clutil_get_submodule_paths(git_root)
    changed_pointers = clutil_get_changed_submodule_pointers(git_root,
                                                             submodules)

    # Check for unassigned changes (ignore untracked files)
    return [file_path for file_path, status in status_map.items()
            if file_path not in assigned_files and status != "??"
            and (file_path not in submodules or file_path in changed_pointers)]


def clutil_validate_changelists_stashable(
        changelists: dict[str, list[str]],
        git_root: Path,
        status_map: dict[str, str]) -> dict[str, list[str]]:
    """
    Pre-flight check that every changelist contains only stashable files.

    'git cl br' must stash ALL active changelists before creating the
    branch. cl_stash deliberately refuses a changelist that contains
    clean files, staged-only modifications, or no stashable changes at
    all. Without this check, such a changelist would abort the workflow
    halfway through: some changelists stashed, others not, and the new
    branch created on top of a dirty working directory (issue #51).
    This function reports all problems up front, before any state is
    mutated, so the user can clean up first.

    Additionally, when more than one changelist is stashed, no file may
    have a staged component (e.g. 'A ' staged additions): git builds a
    pathspec-limited stash from the FULL index, so any staged file —
    even one belonging to another changelist — leaks into every stash
    created while it is staged, and reappears when that stash is
    applied. Staged files must be removed from the index first, e.g.
    with 'git cl unstage <changelist>' (issue #51).

    Args:
        changelists: Active (non-empty) changelists to validate
        git_root: Git repository root
        status_map: Precomputed status map from
                    clutil_get_file_status_map()

    Returns:
        Mapping of changelist name to a list of human-readable problem
        descriptions. An empty dict means every changelist is fully
        stashable and the branch workflow may proceed.
    """
    problems: dict[str, list[str]] = {}

    active = {name: files for name, files in changelists.items() if files}
    multiple_changelists = len(active) > 1

    for name, files in sorted(active.items()):
        existing_files, missing_files = clutil_prepare_stash_files(
            files, git_root)
        file_categories, stashable_files, unstashable_files = (
            clutil_categorize_files_for_stash(
                existing_files, missing_files, status_map, git_root))

        messages = []
        for file_path in file_categories['clean_files']:
            messages.append(f"{file_path} (clean - no changes to stash)")
        for file_path in file_categories['staged_modifications']:
            messages.append(f"{file_path} (only staged changes)")
        known_unstashable = (set(file_categories['clean_files'])
                             | set(file_categories['staged_modifications']))
        for file_path in unstashable_files:
            if file_path not in known_unstashable:
                messages.append(f"{file_path} (not stashable)")
        if not unstashable_files and not stashable_files:
            messages.append("(changelist has no stashable changes)")

        # Staged components leak into every pathspec stash created while
        # they sit in the index (git records the full index state). With
        # a single changelist there is nothing to leak into; with several
        # the file would silently reappear when another stash is applied.
        if multiple_changelists:
            for stored_path, abs_path in existing_files:
                rel = abs_path.relative_to(git_root).as_posix()
                status = status_map.get(rel, "  ")
                if (status[0] not in (' ', '?')
                        and stored_path not in known_unstashable):
                    messages.append(
                        f"{stored_path} (staged - remove from index "
                        "before stashing)")

        if messages:
            problems[name] = messages

    return problems


def clutil_create_branch(branch_name: str,
                         base_branch: str, current_branch: str) -> None:
    """Create new branch from base."""
    if base_branch != current_branch:
        # Create branch from specified base
        subprocess.run(["git", "checkout", "-b", branch_name, base_branch],
                       check=True)
    else:
        # Create branch from current HEAD
        subprocess.run(["git", "checkout", "-b", branch_name], check=True)


def clutil_unstash_changelist(changelist_name: str) -> bool:
    """
    Unstash specific changelist for 'git cl br'. Returns True on success.

    Untracked files outside any changelist are not stashed by 'git cl br',
    so they are still present after the switch to the new branch. They
    must not count as an unclean working directory here, matching the
    pre-flight check in clutil_check_unassigned_changes(). Conflict checks
    stay in force.
    """
    temp_unstash_args = argparse.Namespace()
    temp_unstash_args.name = changelist_name
    temp_unstash_args.force = False
    temp_unstash_args.all = False
    temp_unstash_args.ignore_untracked = True
    return cl_unstash(temp_unstash_args, quiet=True)


def clutil_handle_branch_creation_failure() -> None:
    """Handle failure during branch creation by restoring stashes."""
    try:
        temp_unstash_args = argparse.Namespace()
        temp_unstash_args.all = True
        temp_unstash_args.force = True
        cl_unstash(temp_unstash_args)
    except (OSError, subprocess.CalledProcessError,
            json.JSONDecodeError) as restore_error:
        clutil_print_error(f"Error restoring stashes: {restore_error}")
        clutil_print_error("You may need to manually unstash: git cl unstash --all")


# =============================================================================
# CLI COMMANDS
# =============================================================================

# Every cl_* command returns True on success and False on failure; main()
# turns this into exit code 0 or 1. A command that finds nothing to do
# (e.g. no tracked files to stage) has succeeded. A command that handles
# several names or paths still processes the valid ones, but returns False
# if any of them was rejected. Errors, warnings and their hints are
# printed on stderr via clutil_print_error(), regular output on stdout.

# Up to this many changed files under a directory are listed in a hint;
# beyond that only their number is shown, to keep the output short.
MAX_DIRECTORY_HINT_FILES = 10


# pylint: disable-next=too-many-arguments
def clutil_report_submodule_path(
    file: str,
    sanitized: str,
    submodule: str,
    name: str,
    git_root: Path,
    cwd: Path
) -> None:
    """
    Explain why a submodule, or a path inside one, cannot be added.

    A submodule is a separate repository. Its files are grouped with
    git cl inside the submodule; its recorded commit is committed with
    plain git, like a directory is never part of a changelist.

    Args:
        file: The path as the user gave it
        sanitized: The path relative to the Git root
        submodule: The submodule path relative to the Git root
        name: The changelist name the user asked for
        git_root: Path to the Git repository root
        cwd: The current working directory
    """
    submodule_display = shlex.quote(_relpath(git_root / submodule, cwd))
    if sanitized == submodule:
        clutil_print_error(f"Error: '{file}' is a submodule. Changelists "
                           "contain files only.")
        clutil_print_error("To group files inside it, run git cl in the "
                           "submodule:")
        clutil_print_error(f"  cd {submodule_display} && git cl add {name} "
                           "<files>")
        clutil_print_error("To record its new commit: git add "
                           f"{submodule_display}")
    else:
        inside = shlex.quote(sanitized[len(submodule) + 1:])
        clutil_print_error(f"Error: '{file}' is inside the submodule "
                           f"'{submodule}', which is a separate repository.")
        clutil_print_error("Run git cl there:")
        clutil_print_error(f"  cd {submodule_display} && git cl add {name} "
                           f"{inside}")


def clutil_directory_hint(
        dir_path: str, name: str, status_map: dict[str, str],
        git_root: Path) -> list[str]:
    """
    Build the lines that list the changed files under a directory and the
    'git cl add' command to add them to a changelist.

    Changelists contain files only. When a directory is given, this hint
    shows which files it would mean, so the user can add them by name.
    Every file with a Git status is listed the same way, including
    untracked files, with its status code in front.

    Args:
        dir_path: Directory path relative to the git root
        name: Changelist name for the suggested command
        status_map: Status map including untracked files
        git_root: Repository root

    Returns:
        The hint lines, without the error line itself.
    """
    prefix = dir_path.rstrip("/") + "/"
    if dir_path in ("", "."):
        prefix = ""
    changed = sorted(path for path in status_map if path.startswith(prefix))
    display = _relpath(clutil_resolve_file(git_root / dir_path),
                       Path.cwd().resolve())

    if not changed:
        return [f"No changed files under '{display}'."]

    if len(changed) > MAX_DIRECTORY_HINT_FILES:
        return [f"{len(changed)} changed files under '{display}'. Run "
                "'git cl status' to see them, then add the files you want "
                "by name."]

    cwd = Path.cwd().resolve()
    lines = [f"Changed files under '{display}':"]
    lines += [clutil_format_file_status(path, status_map, git_root, False)
              for path in changed]
    paths = " ".join(shlex.quote(_relpath(clutil_resolve_file(git_root / path), cwd))
                     for path in changed)
    lines.append("To add them, run:")
    lines.append(f"  git cl add {name} {paths}")
    return lines


def cl_add(args: argparse.Namespace) -> bool:
    """
    Adds one or more files to the specified changelist, creating it if needed.
    Prevents adding files that are in stashed changelists.

    Changelists contain files only. A directory is rejected with a hint
    that lists the changed files under it; the other paths are still
    added, and the command exits with 1.
    """
    if not clutil_validate_name(args.name):
        clutil_print_error(
            f"Error: Invalid changelist name '{args.name}'. Names cannot "
            "contain special characters or be Git reserved words.")
        return False

    changelists = clutil_load()
    stashes = clutil_load_stashes()
    git_root = clutil_get_git_root()

    # An active changelist with the name of a stashed one would block
    # 'git cl unstash', which refuses to overwrite an existing changelist.
    if args.name in stashes:
        clutil_print_error(f"Error: Changelist '{args.name}' is stashed.")
        if clutil_find_orphaned_stashes({args.name: stashes[args.name]}):
            clutil_print_orphaned_stash_hint(args.name)
        else:
            clutil_print_error(f"Unstash it first with 'git cl unstash "
                               f"{args.name}', or choose another name.")
        return False

    status_map = clutil_get_file_status_map(
                                            include_untracked=True)

    submodules = clutil_get_submodule_paths(git_root)
    cwd = Path.cwd().resolve()

    known = (clutil_known_paths(git_root, status_map, changelists)
             if clutil_ignores_case() else None)

    files = []
    skipped = False
    for file in args.files:
        sanitized = clutil_sanitize_path(file, git_root)
        if sanitized and known is not None:
            sanitized = clutil_match_case(sanitized, known, git_root)
        if sanitized:
            abs_path = clutil_resolve_file(git_root / sanitized)
            submodule = clutil_find_submodule(sanitized, submodules)
            if submodule:
                clutil_report_submodule_path(file, sanitized, submodule,
                                             args.name, git_root, cwd)
                skipped = True
                continue
            if clutil_is_real_dir(abs_path):
                clutil_print_error(f"Error: '{file}' is a directory. "
                                   "Changelists contain files only.")
                for line in clutil_directory_hint(sanitized, args.name,
                                                  status_map, git_root):
                    clutil_print_error(line)
                skipped = True
                continue
            # A trailing slash on a symlink to a directory means its
            # contents, not the symlink. Git rejects such a path as
            # 'beyond a symbolic link', so point to both options.
            if (file.endswith(("/", os.sep)) and abs_path.is_symlink()
                    and abs_path.is_dir()):
                link_display = file.rstrip("/" + os.sep)
                clutil_print_error(f"Error: '{file}' is a symlink to a "
                                   "directory. Changelists contain files "
                                   "only.")
                clutil_print_error("To add the symlink itself, use "
                                   f"'{link_display}'.")
                try:
                    target = abs_path.resolve().relative_to(git_root)
                except ValueError:
                    clutil_print_error("Its target is outside the "
                                       "repository.")
                else:
                    for line in clutil_directory_hint(
                            target.as_posix(), args.name, status_map,
                            git_root):
                        clutil_print_error(line)
                skipped = True
                continue
            # Warn if the file is neither on disk nor known to Git. A deleted
            # tracked file has a Git status and is a valid change to add.
            if not clutil_path_exists(abs_path) and sanitized not in status_map:
                clutil_print_error(f"Warning: File '{file}' does not exist.")
            files.append(sanitized)
        else:
            clutil_print_error(f"Error: Skipping invalid or unsafe path: '{file}'")
            skipped = True

    # Check if any files are in stashed changelists
    blocked_files = []
    for file_path in files:
        for stash_name, stash_data in stashes.items():
            if file_path in stash_data['files']:
                blocked_files.append((file_path, stash_name))

    if blocked_files:
        clutil_print_error("Error: Cannot add files that are in stashed changelists:")
        for file_path, stash_name in blocked_files:
            clutil_print_error(f"  {file_path} (in stashed changelist '{stash_name}')")
        blocking = {name: stashes[name] for _, name in blocked_files}
        orphaned = clutil_find_orphaned_stashes(blocking)
        if orphaned:
            for name in orphaned:
                clutil_print_orphaned_stash_hint(name)
        else:
            clutil_print_error("Unstash the changelist first if you want to "
                               "modify it.")
        return False

    if args.name not in changelists:
        changelists[args.name] = []

    for file in files:
        # Remove from other active changelists
        for clist in changelists.values():
            if file in clist:
                clist.remove(file)
        if file not in changelists[args.name]:
            changelists[args.name].append(file)

    clutil_save(changelists)
    if files:
        print(f"Added to '{args.name}': {files}")
    return not skipped


def cl_stage(args: argparse.Namespace) -> bool:
    """
    Stages all tracked files in one or more changelists and optionally
    deletes them.

    If any named changelist does not exist, nothing is staged.

    Args:
        args: argparse.Namespace with 'names' and 'delete' attributes.
    """
    changelists = clutil_load()
    names = clutil_resolve_changelist_names(args.names, changelists,
                                            "staged")
    if names is None:
        return False

    git_root = clutil_get_git_root()

    # Fetch git status once and reuse for all files in the changelists
    status_map = clutil_get_file_status_map()

    if clutil_refuse_on_merge_conflict(status_map, "stage"):
        return False

    to_stage, files_by_name = clutil_collect_changelist_files(
        names, changelists, git_root, status_map,
        lambda path: not clutil_is_file_untracked_cached(path, status_map))

    label = clutil_changelist_label(names)
    if not to_stage:
        print(f"No tracked files to stage in {label}.")
        return True

    # A staged deletion ('D ') is already fully staged and no longer exists
    # in the index or on disk, so 'git add' would reject the path
    cwd = Path.cwd().resolve()
    to_add = [
        file for file in to_stage
        if status_map.get(
            clutil_resolve_file(cwd / file).relative_to(git_root).as_posix()) != "D "
    ]

    try:
        if to_add:
            subprocess.run(["git", "add", "--"]
                           + clutil_literal_pathspecs(to_add), check=True)
    except subprocess.CalledProcessError as error:
        clutil_print_error(f"Error staging files: {error}")
        return False

    clutil_print_files_by_changelist("Staged tracked files from", names,
                                     to_stage, files_by_name)

    # Only delete if --delete flag is set
    if args.delete:
        for name in names:
            del changelists[name]
        clutil_save(changelists)
        print(f"Deleted {label}")
    return True


def cl_unstage(args: argparse.Namespace) -> bool:
    """
    Unstages all staged files in one or more changelists, moving them back
    to the working directory as unstaged changes.

    If any named changelist does not exist, nothing is unstaged.

    Args:
        args: argparse.Namespace with 'names' and 'delete' attributes.
    """
    changelists = clutil_load()
    names = clutil_resolve_changelist_names(args.names, changelists,
                                            "unstaged")
    if names is None:
        return False

    git_root = clutil_get_git_root()

    # Get current status to identify staged files
    status_map = clutil_get_file_status_map()

    if clutil_refuse_on_merge_conflict(status_map, "unstage"):
        return False

    # A file has staged changes if the first status character is not a
    # space; untracked files ('??') have nothing staged
    to_unstage, files_by_name = clutil_collect_changelist_files(
        names, changelists, git_root, status_map,
        lambda path: status_map.get(path, "  ")[0] not in " ?")

    label = clutil_changelist_label(names)
    if not to_unstage:
        print(f"No staged files to unstage in {label}.")
        return True

    try:
        # Use git reset HEAD to unstage files
        subprocess.run(["git", "reset", "--quiet", "HEAD", "--"]
                       + clutil_literal_pathspecs(to_unstage),
                       check=True)
    except subprocess.CalledProcessError as error:
        clutil_print_error(f"Error unstaging files: {error}")
        return False

    clutil_print_files_by_changelist("Unstaged files from", names,
                                     to_unstage, files_by_name)

    # Only delete if --delete flag is set
    if args.delete:
        for name in names:
            del changelists[name]
        clutil_save(changelists)
        print(f"Deleted {label}")
    return True


def cl_status(args: argparse.Namespace) -> bool:
    """
    Displays git status grouped by changelist membership,
    including stashed changelists.

    Shows active changelists first, then a separate "Stashed Changelists" section,
    then unassigned files. Filtering by changelist names applies only to active
    changelists unless --include-no-cl is specified.
    """
    selected_names = set(args.names) if args.names else None
    changelists = clutil_load()
    stashes = clutil_load_stashes()
    git_root = clutil_get_git_root()
    status_map = clutil_get_file_status_map(
        include_untracked=not args.no_untracked)

    use_color = clutil_should_use_color(args)

    # Show active changelists
    shown_any_active, assigned_files = clutil_show_active_changelists(
        changelists, selected_names, status_map, git_root, use_color
    )

    # Show stashed changelists section
    if stashes and (selected_names is None):  # Only show when not filtering
        if shown_any_active:
            print()  # Add spacing
        clutil_show_stashed_changelists(stashes)

    # Show unassigned files
    if selected_names is None or args.include_no_cl:
        no_cl_files = [file for file in status_map if file not in assigned_files]
        if no_cl_files:
            if shown_any_active or stashes:
                print()  # Add spacing
            print("No Changelist:")
            for file in sorted(no_cl_files):
                print(clutil_format_file_status(file, status_map, git_root, use_color))

    # Advise user about directory entries, which older versions accepted.
    # Changelists contain files only; the entry is left in place.
    dir_notes = []
    full_status_map = None
    cwd = Path.cwd().resolve()
    for name, files in changelists.items():
        if selected_names is not None and name not in selected_names:
            continue
        for entry in files:
            if not clutil_is_real_dir(git_root / entry):
                continue
            if full_status_map is None:
                full_status_map = clutil_get_file_status_map(
                    include_untracked=True)
            display = _relpath(clutil_resolve_file(git_root / entry), cwd)
            dir_notes.append(f"Note: '{display}' in changelist '{name}' is "
                             "a directory. Changelists contain files only.")
            dir_notes.append("      Remove it with 'git cl rm "
                             f"{shlex.quote(display)}', then add the files "
                             "you want by name.")
            dir_notes += ["      " + line for line in clutil_directory_hint(
                entry, name, full_status_map, git_root)]
    if dir_notes:
        print()
        print("\n".join(dir_notes))

    # Advise user if a rename is split across changelists
    renames = clutil_get_renames()
    if renames:
        notes = []
        for name in changelists:
            if selected_names is None or name in selected_names:
                notes += clutil_note_split_renames([name], changelists,
                                                   renames, git_root)
        if notes:
            print()
            print("\n".join(notes))

    # Advise user if conflicts are present
    conflicts = clutil_detect_merge_conflicts(status_map)
    if conflicts:
        print()
        print(f"Note: {clutil_plural(len(conflicts), 'file')} with merge "
              "conflicts. "
              "Resolve before staging, committing, or stashing.")
    return True


def cl_diff(args: argparse.Namespace) -> bool:
    """
    Show git diff for one or more changelists.

    By default, shows unstaged changes (like `git diff`).
    Use --staged for staged changes, or --both to show both.

    Args:
        args: argparse.Namespace with 'names' list of changelists,
              and optional 'staged' and 'both' flags
    """
    changelists = clutil_load()
    git_root = clutil_get_git_root()
    diff_files = set()
    missing_changelist = False

    # A deleted file is gone from the working directory, but Git still
    # knows it from the index or HEAD and shows the deletion
    all_paths = [path for name in args.names
                 for path in changelists.get(name, [])]
    known_to_git = (clutil_get_paths_in_index(git_root, all_paths)
                    | clutil_get_paths_in_head(git_root, all_paths))
    cwd = Path.cwd().resolve()

    for name in args.names:
        if name not in changelists:
            clutil_print_error(f"Error: Changelist '{name}' not found.")
            missing_changelist = True
            continue
        for path in changelists[name]:
            abs_path = clutil_resolve_file(git_root / path)
            if clutil_path_exists(abs_path) or path in known_to_git:
                diff_files.add(_relpath(abs_path, cwd))
            else:
                clutil_print_error(f"Warning: File '{path}' from '{name}' does not "
                                   "exist.")

    if not diff_files:
        if missing_changelist:
            return False
        print("No valid files to diff.")
        return True

    sorted_files = sorted(diff_files)

    def run_diff(extra: list[str]) -> bool:
        """Run one git diff; report a failure and return False on it."""
        sys.stdout.flush()
        try:
            result = subprocess.run(["git", "diff"] + extra + ["--"]
                                    + clutil_literal_pathspecs(sorted_files), check=False)
        except OSError as error:
            clutil_print_error(f"Error running git diff: {error}")
            return False
        if result.returncode != 0:
            clutil_print_error(f"Error: git diff {' '.join(extra)}".rstrip()
                               + f" failed with exit code {result.returncode}.")
            return False
        return True

    if args.both:
        # Show both unstaged and staged diffs; a failure of one does not
        # stop the other
        print("=== Unstaged changes (working tree vs index) ===")
        unstaged_ok = run_diff([])
        print("\n=== Staged changes (index vs HEAD) ===")
        staged_ok = run_diff(["--staged"])
        succeeded = unstaged_ok and staged_ok
    elif args.staged:
        succeeded = run_diff(["--staged"])
    else:
        succeeded = run_diff([])

    return succeeded and not missing_changelist


def clutil_get_paths_in_index(git_root: Path, paths: list[str]) -> set[str]:
    """
    Return which of the given paths are in the index.

    Args:
        git_root: Path to the Git repository root
        paths: File paths relative to the Git root

    Returns:
        The subset of paths that are in the index. Empty if Git fails.
    """
    if not paths:
        return set()
    try:
        output = subprocess.run(
            ["git", "-C", str(git_root), "ls-files", "-z", "--cached", "--"]
            + clutil_literal_pathspecs(paths),
            check=True, capture_output=True, text=True).stdout
    except subprocess.CalledProcessError:
        return set()
    return {path for path in output.split("\0") if path}


def clutil_get_paths_in_head(git_root: Path, paths: list[str]) -> set[str]:
    """
    Return which of the given paths exist as files in HEAD.

    Args:
        git_root: Path to the Git repository root
        paths: File paths relative to the Git root

    Returns:
        The subset of paths that are in HEAD. Empty if there is no commit
        yet or Git fails.
    """
    if not paths:
        return set()
    try:
        output = subprocess.run(
            ["git", "-C", str(git_root), "ls-tree", "-r", "-z", "--name-only",
             "HEAD", "--"] + clutil_literal_pathspecs(paths),
            check=True, capture_output=True, text=True).stdout
    except subprocess.CalledProcessError:
        return set()
    return {path for path in output.split("\0") if path}


def cl_checkout(args: argparse.Namespace) -> bool:
    """
    Checkout (revert) files from one or more changelists to their HEAD state.

    This discards local changes in the working directory for the specified files,
    reverting them to their last committed state. Useful for undoing unwanted
    local modifications. Optionally deletes the changelist(s) after checkout.

    Args:
        args: argparse.Namespace with 'names' list of changelist names,
              optional 'force' flag for confirmation, and optional 'delete'
              flag to remove changelist(s) after checkout.
    """
    # A name given twice is handled once, as in stage and commit
    args.names = list(dict.fromkeys(args.names))
    changelists = clutil_load()
    git_root = clutil_get_git_root()

    # Check for merge conflicts before doing anything destructive
    status_map = clutil_get_file_status_map()
    if clutil_refuse_on_merge_conflict(status_map, "checkout"):
        return False

    # Collect all files from specified changelists
    all_files = []
    missing_changelists = []

    for name in args.names:
        if name not in changelists:
            missing_changelists.append(name)
            continue

        files = changelists[name]
        if not files:
            clutil_print_error(f"Warning: Changelist '{name}' is empty.")
            continue

        all_files.extend(files)

    # Report missing changelists
    if missing_changelists:
        clutil_print_error("Error: The following changelists were not found:")
        for name in missing_changelists:
            clutil_print_error(f"  {name}")
        if not all_files:  # No valid changelists found
            return False

    if not all_files:
        print("No files to checkout.")
        return True

    # Only files in HEAD can be reverted to it. This includes deleted
    # files, which are restored. git checkout would reject the whole
    # pathspec for a single file that is not in HEAD, so such files are
    # filtered out and reported separately.
    in_head = clutil_get_paths_in_head(git_root, all_files)

    # Convert to paths relative to current working directory for git command
    checkout_files = []
    missing_files = []
    untracked_files = []
    new_files = []

    for stored_path in all_files:
        abs_path = clutil_resolve_file(git_root / stored_path)

        if stored_path in in_head:
            checkout_files.append(_relpath(abs_path, Path.cwd().resolve()))
        elif clutil_is_file_untracked_cached(stored_path, status_map):
            untracked_files.append(stored_path)
        elif clutil_path_exists(abs_path):
            # Staged as a new file (or as the new name of a rename)
            new_files.append(stored_path)
        else:
            missing_files.append(stored_path)

    # Report missing files
    if missing_files:
        clutil_print_error("Warning: The following files do not exist and will be "
                           "skipped:")
        for file_path in missing_files:
            clutil_print_error(f"  {file_path}")

    # Report untracked files (cannot be reverted - no committed state)
    if untracked_files:
        clutil_print_error("Warning: The following untracked files cannot be reverted "
                           "and will be skipped:")
        for file_path in untracked_files:
            clutil_print_error(f"  {file_path}")

    # Report new files (not in HEAD, so there is nothing to revert to)
    if new_files:
        clutil_print_error("Warning: The following new files are not in HEAD "
                           "and will be skipped:")
        for file_path in new_files:
            clutil_print_error(f"  {file_path}")
        clutil_print_error("To unstage them and keep the files: git restore "
                           "--staged -- <files>")

    if not checkout_files:
        print("No files to revert to HEAD.")
        return not missing_changelists

    # Show what will be affected and ask for confirmation unless --force
    print("This will discard local changes in "
          f"{clutil_plural(len(checkout_files), 'file')}:")
    for file_path in checkout_files[:10]:  # Show first 10 files
        print(f"  {file_path}")
    if len(checkout_files) > 10:
        print(f"  ... and {len(checkout_files) - 10} more files")

    if not args.force:
        try:
            response = input("\nProceed? [y/N]: ").strip().lower()
            if response not in ('y', 'yes'):
                print("Checkout cancelled.")
                return False
        except (EOFError, KeyboardInterrupt):
            print("\nCheckout cancelled.")
            return False

    # Perform the checkout
    try:
        subprocess.run(["git", "checkout", "HEAD", "--"]
                       + clutil_literal_pathspecs(checkout_files),
                       check=True)
        print("Successfully reverted "
              f"{clutil_plural(len(checkout_files), 'file')} to HEAD state.")


        # Show summary by changelist. Only files in HEAD were reverted;
        # untracked, new and missing files were skipped above.
        print("\nFiles reverted by changelist:")
        for name in args.names:
            if name in changelists and changelists[name]:
                reverted_count = sum(1 for f in changelists[name]
                                     if f in in_head)
                if reverted_count > 0:
                    print(f"  {name}: {clutil_plural(reverted_count, 'file')}")

        # Delete changelists if --delete flag is set
        if args.delete:
            deleted_any = False
            for name in args.names:
                if name in changelists:
                    del changelists[name]
                    print(f"Deleted changelist '{name}'")
                    deleted_any = True

            if deleted_any:
                clutil_save(changelists)

    except subprocess.CalledProcessError as error:
        clutil_print_error(f"Error during checkout: {error}")
        clutil_print_error("Some files may not have been reverted.")
        return False

    # Changelists that were not found are reported above; the existing
    # ones are still reverted, but the command as a whole has failed.
    return not missing_changelists


def cl_remove(args: argparse.Namespace) -> bool:
    """
    Removes one or more files from any changelists they are part of.

    Args:
        args: argparse.Namespace with 'files' attribute.
    """
    changelists = clutil_load()
    removed = []
    failed = False

    git_root = clutil_get_git_root()
    stored = ([f for files in changelists.values() for f in files]
              if clutil_ignores_case() else None)
    for file in args.files:
        sanitized = clutil_sanitize_path(file, git_root)
        if sanitized is None:
            clutil_print_error(f"Error: Skipping invalid or unsafe path: '{file}'")
            failed = True
            continue
        if stored is not None:
            sanitized = clutil_match_case(sanitized, stored, git_root)

        found = False
        for name, files in changelists.items():
            if sanitized in files:
                files.remove(sanitized)
                removed.append(sanitized)
                print(f"Removed '{sanitized}' from changelist '{name}'")
                found = True
                break  # Stop after first match

        if not found:
            clutil_print_error(f"Error: '{file}' was not found in any changelist.")
            failed = True

    if removed:
        clutil_save(changelists)
    return not failed


def cl_delete(args: argparse.Namespace) -> bool:
    """
    Deletes one or more changelists by name, or all with --all.
    """
    changelists = clutil_load()
    stashes = clutil_load_stashes()

    if args.all and args.names:
        clutil_print_error("Error: Cannot specify changelist names and --all together.")
        return False

    if args.all:
        if not changelists:
            print("No changelists to delete.")
            return True
        count = len(changelists)
        changelists.clear()
        clutil_save(changelists)
        print(f"Deleted all {count} changelists.")
        return True

    if not args.names:
        clutil_print_error("Error: No changelist names provided.")
        return False

    deleted = False
    missing = False
    for name in args.names:
        if name in changelists:
            del changelists[name]
            print(f"Deleted changelist '{name}'")
            deleted = True
        elif name in stashes:
            clutil_print_error(f"Error: Changelist '{name}' is stashed. "
                               "Delete only removes active changelists.")
            clutil_print_error(f"Unstash it first with 'git cl unstash {name}'.")
            missing = True
        else:
            clutil_print_error(f"Error: Changelist '{name}' not found.")
            missing = True

    if deleted:
        clutil_save(changelists)
    return not missing


def cl_prune(args: argparse.Namespace) -> bool:
    """
    Removes stale entries from all active changelists.

    See clutil_prune() for what counts as stale.

    With --exit-code, the exit code tells whether stale entries were
    found, following 'git diff --exit-code': 0 if there were none, 1 if
    there were (removed, or only listed with --dry-run), and 2 on error.
    Errors in git-cl normally exit with 1, so they are mapped to 2 here to
    keep them apart from 'stale entries found'.

    Args:
        args: argparse.Namespace with 'dry_run', 'quiet' and 'exit_code'
              attributes.
    """
    if not getattr(args, 'exit_code', False):
        clutil_prune(args)
        return True

    try:
        total = clutil_prune(args)
    except SystemExit as error:
        if error.code not in (0, None):
            sys.exit(2)
        raise
    sys.exit(1 if total else 0)


def clutil_prune(args: argparse.Namespace) -> int:
    """
    Removes stale entries from all active changelists.

    An entry is stale when Git reports nothing for it: the file has no
    staged or unstaged changes, or it no longer exists and is unknown to
    Git (shown as [XX] in 'git cl status'). Such entries typically remain
    after committing with plain 'git commit'.

    Entries with any Git status (modified, staged, deleted, untracked,
    conflicted) are kept. A directory entry is kept as long as any file
    inside it has a Git status. Only changelist metadata is changed, never
    file contents.

    Stashed changelists are kept, except for orphaned records whose Git
    stash no longer exists (see clutil_find_orphaned_stashes()). Removing
    such a record frees its files for other changelists. Each orphaned
    record counts as one stale entry.

    Does nothing when the GIT_CL_NO_PRUNE environment variable is set,
    which 'git cl commit' does for its own commit (see NO_PRUNE_ENV).

    Args:
        args: argparse.Namespace with 'dry_run' and 'quiet' attributes.

    Returns:
        The number of stale entries found (removed, or only listed in a
        dry run).
    """
    if os.environ.get(NO_PRUNE_ENV):
        return 0

    changelists = clutil_load()
    git_root = clutil_get_git_root()

    # Untracked files are listed individually so that an untracked file
    # inside an untracked directory still counts as having a status.
    status_map = clutil_get_file_status_map(
                                            include_untracked=True)

    def is_stale(stored_path: str) -> bool:
        if stored_path in status_map:
            return False
        if clutil_is_real_dir(git_root / stored_path):
            prefix = stored_path.rstrip("/") + "/"
            return not any(path.startswith(prefix) for path in status_map)
        return True

    pruned: dict[str, list[str]] = {}
    for name, files in changelists.items():
        stale = [f for f in files if is_stale(f)]
        if stale:
            pruned[name] = stale

    stashes = clutil_load_stashes()
    orphaned = clutil_find_orphaned_stashes(stashes)

    if not pruned and not orphaned:
        if not args.quiet:
            print("Nothing to prune.")
        return 0

    # Changelists whose every entry is stale will end up empty
    emptied = sorted(name for name, stale in pruned.items()
                     if len(stale) == len(changelists[name]))

    verb = "Would remove" if args.dry_run else "Removed"
    cwd = Path.cwd().resolve()
    total = sum(len(stale) for stale in pruned.values()) + len(orphaned)

    if not args.quiet:
        for name in orphaned:
            print(f"{verb} stashed changelist '{name}': its Git stash no "
                  "longer exists")
            files = [shlex.quote(_relpath(git_root / f, cwd))
                     for f in stashes[name]["files"]]
            if files and not args.dry_run:
                print(f"  To group its files again: git cl add {name} "
                      + " ".join(files))
    for name, stale in sorted(pruned.items()):
        if not args.quiet:
            for stored_path in stale:
                display = _relpath(git_root / stored_path, cwd)
                print(f"{verb} '{display}' from changelist '{name}'")
        if not args.dry_run:
            changelists[name] = [f for f in changelists[name]
                                 if f not in stale]

    if args.dry_run:
        if not args.quiet:
            for name in emptied:
                print(f"Changelist '{name}' would become empty "
                      "and be deleted.")
            print(f"Dry run: {total} stale entr"
                  f"{'y' if total == 1 else 'ies'} found, nothing changed.")
        return total

    if orphaned:
        for name in orphaned:
            del stashes[name]
        clutil_save_stashes(stashes)

    # clutil_save omits empty changelists, so emptied ones disappear here
    if pruned:
        clutil_save(changelists)

    if not args.quiet:
        for name in emptied:
            print(f"Deleted empty changelist '{name}'")
        print(f"Pruned {total} stale entr{'y' if total == 1 else 'ies'}.")
    return total


def cl_commit(args: argparse.Namespace) -> bool:
    """
    Commits all tracked files in one or more changelists as a single
    commit, then optionally deletes them.

    If any named changelist does not exist, nothing is committed.
    Duplicate names are ignored.

    Args:
        args: argparse.Namespace with 'names', 'message'/'file',
              and 'keep' attributes.
    """
    changelists = clutil_load()
    names = clutil_resolve_changelist_names(args.names, changelists,
                                            "committed")
    if names is None:
        return False

    git_root = clutil_get_git_root()

    # Fetch git status once and reuse for all files in the changelists
    status_map = clutil_get_file_status_map()

    if clutil_refuse_on_merge_conflict(status_map, "commit"):
        return False

    to_commit, files_by_name = clutil_collect_changelist_files(
        names, changelists, git_root, status_map,
        lambda path: not clutil_is_file_untracked_cached(path, status_map))

    label = clutil_changelist_label(names)
    if not to_commit:
        print(f"No tracked files to commit in {label}.")
        return True

    commit_message = clutil_resolve_commit_message(args)
    if not commit_message:
        return False

    # Point out renames of which only one side is being committed
    for line in clutil_note_split_renames(names, changelists,
                                          clutil_get_renames(), git_root):
        print(line)

    try:
        # Keep a post-commit hook running 'git cl prune' from acting on
        # this commit (see NO_PRUNE_ENV)
        subprocess.run(["git", "commit", "-m", commit_message, "--"]
                       + clutil_literal_pathspecs(to_commit), check=True,
                       env={**os.environ, NO_PRUNE_ENV: "1"})
    except subprocess.CalledProcessError as error:
        clutil_print_error(f"Error committing {label}: {error}")
        return False

    clutil_print_files_by_changelist("Committed tracked files from", names,
                                     to_commit, files_by_name)

    if not args.keep:
        for name in names:
            del changelists[name]
        clutil_save(changelists)
        print(f"Deleted {label}")
    else:
        print(f"Kept {label}")
    return True


def cl_stash(args: argparse.Namespace, quiet: bool = False) -> bool:
    """
    Stash all unstaged changes for files in specified changelist(s).
    Supports --all to stash all active changelists.
    Tracks source branch for better workflow support.

    Accepts files with:
    - Unstaged changes (modified, deleted)
    - Newly added to index (staged additions)
    - Untracked files (if explicitly in changelist)

    Args:
        args: argparse.Namespace with 'name'
              (or None for --all), 'all' attributes.
        quiet: If True, suppress verbose output for workflow contexts

    Returns:
        True if the stash succeeded (for --all: all changelists were
        stashed), False otherwise. Callers such as cl_branch rely on
        this to detect failures that are otherwise only printed.
    """
    changelists = clutil_load()
    stashes = clutil_load_stashes()

    if not clutil_has_commits():
        clutil_print_error("Error: Cannot stash before the first commit; Git "
                           "needs a commit to stash changes against.")
        clutil_print_error("Commit something first, for example: "
                           "git cl commit <changelist> -m 'Initial commit'")
        return False

    # Handle --all flag
    if getattr(args, 'all', False):
        success_count, total = clutil_stash_all_changelists(changelists,
                                                            quiet=quiet)
        return success_count == total

    # Handle single changelist stash
    name = args.name

    # Validate preconditions
    error_msg = clutil_validate_stash_preconditions(name, changelists, stashes)
    if error_msg:
        clutil_print_error(error_msg)
        return False

    git_root = clutil_get_git_root()
    files = changelists[name]

    # Check that files exist and categorize them
    existing_files, missing_files = clutil_prepare_stash_files(files, git_root)

    # Get file statuses and categorize
    status_map = clutil_get_file_status_map()

    if clutil_refuse_on_merge_conflict(status_map, "stash"):
        return False

    categorization = clutil_categorize_files_for_stash(
        existing_files, missing_files, status_map, git_root
    )
    file_categories, stashable_files, unstashable_files = categorization

    # Report categorization and check if we can proceed (suppress in quiet mode)
    if not clutil_report_stash_categorization(file_categories,
                                              unstashable_files, name, quiet=quiet):
        return False

    if not stashable_files:
        if not quiet:
            print(f"No stashable files found in changelist '{name}'.")
        return False

    # Prepare files for git stash command
    current_branch = clutil_get_current_branch()
    if not quiet:
        if current_branch:
            branch_info = f" from branch '{current_branch}'"
        else:
            branch_info = " from detached HEAD"
        print(f"\nStashing {clutil_plural(len(stashable_files), 'file')} "
              f"from changelist '{name}'{branch_info}...")

    files_for_git, untracked_files_for_git = clutil_prepare_files_for_git_stash(
        stashable_files, file_categories, git_root, quiet=quiet
    )

    # Generate the unique stash message once and thread it through both the
    # git stash push and the metadata save. Generating it independently in
    # each place risks the two timestamps differing across a second boundary,
    # leaving cl-stashes.json with a message that doesn't match git's stash.
    stash_message = clutil_create_unique_stash_message(name)

    # Execute git stash with safe directory handling
    try:
        with clutil_safe_stash_context(
                git_root, files_for_git,
                untracked_files_for_git) as (safe_files, safe_untracked_files):
            stash_ref = clutil_execute_git_stash(name, stash_message,
                                                 safe_files,
                                                 safe_untracked_files)
    except (subprocess.CalledProcessError, ValueError):
        return False

    # Save metadata atomically
    try:
        clutil_save_stash_metadata_atomic(
            name, stash_message, stash_ref, files,
            file_categories, changelists, stashes
        )
    except ClutilSaveError:
        clutil_handle_stash_failure(name, stash_ref, stash_message,
                                    safe_files, safe_untracked_files,
                                    git_root)
        return False

    # Success! Print appropriate message based on context
    if not quiet:
        clutil_print_stash_success(name, stashable_files,
                                   file_categories, current_branch)
    return True


def cl_unstash(args: argparse.Namespace, quiet: bool = False) -> bool:
    """
    Restore a stashed changelist to the working directory.
    Enforces clean branch workflow by default.
    Supports --all to unstash all stashed changelists.

    Args:
        args: argparse.Namespace with 'name' (or None for --all),
            'force', and 'all' attributes.
        quiet: If True, suppress verbose output for workflow contexts

    Returns:
        True if the unstash succeeded (for --all: all changelists were
        unstashed), False otherwise. Callers such as cl_branch rely on
        this to detect failures that are otherwise only printed.
    """
    stashes = clutil_load_stashes()
    changelists = clutil_load()

    status_map = clutil_get_file_status_map()
    if clutil_refuse_on_merge_conflict(status_map, "unstash"):
        return False

    # Handle --all flag
    if getattr(args, 'all', False):
        success_count, total = clutil_unstash_all_changelists(
            stashes, getattr(args, 'force', False))
        return success_count == total

    # Handle single changelist unstash
    name = args.name
    # Stashes are keyed by the changelist name itself
    base_name = stash_key = name

    # A record whose stash is gone can never be unstashed. Say so before
    # any other check, which would only point to the working directory.
    if stash_key in stashes and clutil_find_orphaned_stashes(
            {stash_key: stashes[stash_key]}):
        clutil_print_error(f"Error: Cannot unstash changelist '{base_name}'.")
        clutil_print_orphaned_stash_hint(base_name)
        return False

    # Validate environment and get stash data
    error_msg, stash_data = clutil_validate_unstash_environment(
        base_name, stash_key, stashes, changelists,
        getattr(args, 'force', False),
        getattr(args, 'ignore_untracked', False)
    )
    if error_msg or stash_data is None:
        clutil_print_error(error_msg or f"Error: No stash record for "
                           f"'{base_name}'.")
        return False

    stash_ref = stash_data["stash_ref"]
    files = stash_data["files"]
    git_root = clutil_get_git_root()

    # Check for conflicts (suppress verbose output in quiet mode)
    if not clutil_check_and_report_conflicts(files, git_root, base_name,
                                             getattr(args, 'force', False),
                                             quiet=quiet):
        return False

    # Verify stash still exists and update reference
    stash_ref = clutil_verify_and_update_stash_ref(base_name, stash_ref,
                                                   stash_data)
    if not stash_ref:
        return False

    # Apply the stash (suppress verbose output in quiet mode)
    result = clutil_apply_stash(stash_ref, base_name, stash_data, quiet=quiet)
    if result == "failed":
        return False
    if result == "conflict":
        # The changes are applied. Restore the changelist so that a second
        # unstash cannot apply them again; the stash itself is kept.
        clutil_update_unstash_metadata(base_name, stash_key, files,
                                       changelists, stashes, quiet=True)
        return False

    # Success - update metadata (suppress verbose output in quiet mode)
    return clutil_update_unstash_metadata(base_name, stash_key, files,
                                          changelists, stashes, quiet=quiet)


def cl_branch(args: argparse.Namespace) -> bool:
    """
    Create a new branch with changelist workflow: stash all changelists,
    create branch, unstash specified changelist.

    This automates the common workflow of:
    1. Stash all active changelists to clean working directory
    2. Create a new branch from current HEAD (or specified base)
    3. Unstash the specified changelist to the new branch

    Args:
        args: argparse.Namespace with 'changelist_name', optional 'branch_name',
              and optional 'from_branch' attributes.
    """
    changelists = clutil_load()
    stashes = clutil_load_stashes()

    changelist_name = args.changelist_name
    branch_name = getattr(args, 'branch_name', None) or changelist_name

    # Validate changelist exists and is active
    error_msg = clutil_validate_branch_preconditions(changelist_name,
                                                     changelists, stashes)
    if error_msg:
        clutil_print_error(error_msg)
        return False

    if not clutil_has_commits():
        clutil_print_error("Error: Cannot create a branch before the first "
                           "commit. Commit something first, for example:")
        clutil_print_error(f"  git cl commit {changelist_name} -m 'Initial "
                           "commit'")
        return False

    # Check the name with Git's rules before anything is stashed
    if subprocess.run(["git", "check-ref-format", "--branch", branch_name],
                      capture_output=True, text=True,
                      check=False).returncode != 0:
        clutil_print_error(f"Error: '{branch_name}' is not a valid branch "
                           "name.")
        clutil_print_error("See 'git help check-ref-format' for the rules.")
        return False

    # Check if branch already exists
    if clutil_check_branch_exists(branch_name):
        clutil_print_error(f"Error: Branch '{branch_name}' already exists.")
        clutil_print_error(f"Use a different branch name: git cl br "
                           f"{changelist_name} <new-branch-name>")
        return False

    # Check for uncommitted changes not in any changelist
    git_root = clutil_get_git_root()
    unassigned_changes = clutil_check_unassigned_changes(changelists, git_root)

    if unassigned_changes:
        submodules = clutil_get_submodule_paths(git_root)
        changed_submodules = [f for f in unassigned_changes if f in submodules]
        unassigned_files = [f for f in unassigned_changes
                            if f not in submodules]
        status_map = clutil_get_file_status_map()
        clutil_print_error("Error: There are uncommitted changes not in any "
                           "changelist:")
        for file_path in unassigned_changes[:10]:  # Show first 10
            clutil_print_error(f"  [{status_map[file_path]}] {file_path}")
        if len(unassigned_changes) > 10:
            clutil_print_error(f"  ... and {len(unassigned_changes) - 10} more files")
        if unassigned_files:
            clutil_print_error("\nPlease assign these files to changelists first:")
            clutil_print_error("  git cl add <changelist-name> "
                               f"{' '.join(unassigned_files[:3])}")
        if changed_submodules:
            names = " ".join(shlex.quote(p) for p in changed_submodules)
            clutil_print_error("\nSubmodules point to a new commit. Changelists "
                               "cannot contain submodules;")
            clutil_print_error("record the new commit, or reset the submodule:")
            clutil_print_error(f"  git add {names} && git commit")
            clutil_print_error(f"  git submodule update -- {names}")
        return False

    # Get current branch for messaging
    current_branch = clutil_get_current_branch()
    if not current_branch:
        clutil_print_error("Error: Cannot create branch from detached HEAD state.")
        clutil_print_error("Switch to a branch first: git checkout <branch-name>")
        return False

    # Determine base branch
    base_branch = getattr(args, 'from_branch', None) or current_branch

    # Collect active changelists for the workflow
    active_changelists = {name: files for name, files in changelists.items() if files}

    # Pre-flight: every active changelist must be fully stashable.
    # cl_stash refuses changelists containing clean or staged-only files,
    # so a single such changelist would otherwise abort the workflow
    # halfway through and leave the repo inconsistent (issue #51).
    # Fail fast here, before any state is mutated.
    status_map = clutil_get_file_status_map()
    problems = clutil_validate_changelists_stashable(
        active_changelists, git_root, status_map)
    if problems:
        clutil_print_error("Error: Not all changelists can be stashed cleanly:")
        for cl_name, messages in sorted(problems.items()):
            clutil_print_error(f"  {cl_name}:")
            for message in messages:
                clutil_print_error(f"    {message}")
        clutil_print_error("\n'git cl br' must stash every active changelist before "
                           "creating the branch.")
        clutil_print_error("Staged files must be removed from the index first: git "
                           "builds each stash\nfrom the full index, so staged files "
                           "leak into other changelists' stashes.")
        clutil_print_error("Clean up the changelists above first, for example:")
        clutil_print_error("  - Remove staged files from the index: "
                           "git cl unstage <changelist>")
        clutil_print_error("  - Remove clean files from a changelist: git cl rm "
                           "<files>")
        clutil_print_error("  - Or commit them: git cl commit <changelist> -m '...'")
        clutil_print_error("  - Delete obsolete changelists: git cl delete "
                           "<changelist>")
        clutil_print_error("\nThen retry: git cl br "
                           f"{changelist_name} {branch_name}")
        return False

    print(f"Creating branch '{branch_name}' with changelist '{changelist_name}'")
    if len(active_changelists) > 1:
        print(f"Stashing {len(active_changelists)} active changelists...")

    # Step 1: Stash all active changelists (quietly)
    try:
        success_count, total = clutil_stash_all_changelists(
            active_changelists, quiet=True)
    except (subprocess.CalledProcessError,
            OSError, json.JSONDecodeError) as error:
        clutil_print_error(f"Error during stash operation: {error}")
        clutil_print_error("Branch creation aborted.")
        return False

    # The pre-flight check should make this unreachable, but git stash
    # can still fail for other reasons (I/O errors, hooks, ...). Never
    # create the branch on top of a partially stashed working directory.
    if success_count != total:
        clutil_print_error(f"Error: Only {success_count}/{total} changelists could "
                           "be stashed.")
        clutil_print_error("Branch creation aborted. Restoring stashed changelists...")
        clutil_handle_branch_creation_failure()
        return False

    # Step 2: Create the new branch
    try:
        # git checkout already reports "Switched to a new branch ..."
        clutil_create_branch(branch_name, base_branch, current_branch)
    except subprocess.CalledProcessError as error:
        clutil_print_error(f"Error creating branch: {error}")
        clutil_print_error("Attempting to restore stashed changelists...")
        clutil_handle_branch_creation_failure()
        return False

    # Step 3: Unstash the target changelist (quietly)
    try:
        if not clutil_unstash_changelist(changelist_name):
            clutil_print_error(f"Error: Branch '{branch_name}' was created but "
                               f"restoring changelist '{changelist_name}' failed.")
            clutil_print_error(f"Changelist '{changelist_name}' is still "
                               "stashed. Resolve the problem above, then "
                               f"run: git cl unstash {changelist_name}")
            return False

        # Single success message
        file_count = len(changelists.get(changelist_name, []))
        print(f"Restored changelist '{changelist_name}' "
              f"({clutil_plural(file_count, 'file')})")
        print("Ready to work on your feature!")
        return True

    except (subprocess.CalledProcessError,
            OSError, json.JSONDecodeError) as error:
        clutil_print_error(f"Error unstashing changelist: {error}")
        clutil_print_error(f"Branch '{branch_name}' was created but "
                           "changelist restore failed.")
        clutil_print_error(f"Changelist '{changelist_name}' is still "
                           "stashed. Resolve the problem above, then "
                           f"run: git cl unstash {changelist_name}")
        return False


def cl_help(args: argparse.Namespace) -> bool:
    """
    Displays the main help message using argparse's built-in formatting.
    """
    args.parser.print_help()
    return True


# =============================================================================
# MAIN ENTRY POINT
# =============================================================================


def main() -> None:
    """
    Entry point for the git-cl command-line interface.

    Parses command-line arguments and dispatches to the appropriate
    subcommand handler (e.g., add, remove, stage, commit, etc.).
    """

    parser = argparse.ArgumentParser(
        prog='git-cl',
        usage='git cl <command> [<args>]',
        description=(
            "git-cl: A Git subcommand for managing named changelists \n"
            "        Group files into logical changelists before staging "
            "or committing.\n\n"
            "        NOTE: Commit/stage commands only operate on tracked files;"
            "\n              untracked files in changelists are safely "
            "ignored."),
        epilog=(
            "Example usage:\n"
            "    git cl add my-feature file1.py file2.py\n"
            "    git cl status\n"
            "    git cl commit my-feature -m 'Implement feature'\n\n"
            "About: \n"
            f"    Version: {__version__}\n"
            "    GitHub:  https://github.com/BHFock/git-cl \n"
            "    DOI:     https://doi.org/10.5281/zenodo.18722077"),
        formatter_class=argparse.RawTextHelpFormatter,
        add_help=False)

    parser.add_argument(
        '--version',
        action='version',
        version=f'git-cl {__version__}',
        help=argparse.SUPPRESS)

    subparsers = parser.add_subparsers(dest='command', title='Commands',
                                       prog='git cl')

    # ADD
    add_parser = subparsers.add_parser('add', aliases=['a'],
                                       help='Add files to a named changelist',
                                       description=(
                                           "Add one or more files to a named "
                                           "changelist. If the changelist "
                                           "does not exist, it will be "
                                           "created automatically."))
    add_parser.add_argument('name', metavar='CHANGELIST',
                            help='Name of the changelist to add files to')
    add_parser.add_argument('files', metavar='FILE', nargs='+',
                            help=("One or more files to include "
                                  "in the changelist"))
    add_parser.set_defaults(func=cl_add)

    # REMOVE
    remove_parser = subparsers.add_parser('remove', aliases=['r', 'rm'],
                                          help=("Remove files from any "
                                                "changelist"),
                                          description=("Removes files from "
                                                       "any changelists they "
                                                       "belong to."))
    remove_parser.add_argument('files', metavar='FILE', nargs='+',
                               help=("One or more files to remove "
                                     "from changelists"))
    remove_parser.set_defaults(func=cl_remove)

    # DELETE
    delete_parser = subparsers.add_parser('delete', aliases=['del'],
                                          help=("Delete one or more "
                                                "changelists"),
                                          description=(
                                              "Delete one or more changelists "
                                              "by name, or remove all with "
                                              "--all."))
    delete_parser.add_argument('names', metavar='CHANGELIST', nargs='*',
                               help=("One or more changelists to delete "
                                     "(required unless --all is used)"))
    delete_parser.add_argument('--all', action='store_true',
                               help='Delete all changelists')
    delete_parser.set_defaults(func=cl_delete)

    # PRUNE
    prune_parser = subparsers.add_parser('prune',
                                         help=("Remove files without "
                                               "changes from all "
                                               "changelists"),
                                         description=(
                                             "Remove stale entries from all "
                                             "changelists: files with no "
                                             "staged or unstaged changes, "
                                             "and files that no longer "
                                             "exist and are unknown to Git. "
                                             "These typically remain after "
                                             "committing with plain 'git "
                                             "commit'. Changelists left "
                                             "empty are deleted. Only "
                                             "changelist metadata is "
                                             "changed, never file contents. "
                                             "Stashed changelists are kept, "
                                             "unless their Git stash no "
                                             "longer exists. Files excluded by "
                                             ".gitignore have no Git status "
                                             "and are removed as well. Does "
                                             "nothing during 'git cl "
                                             "commit', so that a post-commit "
                                             "hook only acts on commits made "
                                             "outside git-cl."))
    prune_parser.add_argument('-n', '--dry-run', action='store_true',
                              help=("Show what would be removed without "
                                    "changing anything"))
    prune_parser.add_argument('-q', '--quiet', action='store_true',
                              help=("Suppress output (useful in a "
                                    "post-commit hook)"))
    prune_parser.add_argument('--exit-code', action='store_true',
                              help=("Exit with 1 if stale entries were "
                                    "found and 0 if not; errors exit "
                                    "with 2"))
    prune_parser.set_defaults(func=cl_prune)

    # STATUS
    status_parser = subparsers.add_parser('status', aliases=['s', 'st'],
                                          help=("Show file changes grouped by "
                                                "changelist"),
                                          description=(
                                              "Show file changes grouped by "
                                              "changelist. Unassigned files "
                                              "appear under 'No Changelist'."))
    status_parser.add_argument('names', metavar='CHANGELIST', nargs='*',
                               help=("Optional list of changelists to show "
                                     "(default: all)"))
    status_parser.add_argument('--include-no-cl', action='store_true',
                               help=("When filtering by changelist names, "
                                     "also show files not assigned to any "
                                     "changelist"))
    status_parser.add_argument('--all', action='store_true',
                               help=("No longer needed: all Git status "
                                     "codes are shown. Accepted for "
                                     "existing scripts"))
    status_parser.add_argument('--no-untracked', action='store_true',
                               help='Hide untracked files (??) from output')
    status_parser.add_argument('--no-color', action='store_true',
                               help='Disable coloured output')
    status_parser.set_defaults(func=cl_status)

    # DIFF
    diff_parser = subparsers.add_parser('diff',
                                        help=("Show git diff for one or more "
                                              "changelists"),
                                        description=(
                                            "Show unified diff for the files "
                                            "in one or more changelists. "
                                            "By default, shows unstaged "
                                            "changes (like `git diff`). "
                                            "Use --staged for staged changes, "
                                            "or --both to show both."))
    diff_parser.add_argument('names', metavar='CHANGELIST', nargs='+',
                             help='One or more changelists to diff')
    diff_parser.add_argument('--staged', action='store_true',
                             help='Show staged changes (index vs HEAD)')
    diff_parser.add_argument('--both', action='store_true',
                             help='Show both unstaged and staged diffs')
    diff_parser.set_defaults(func=cl_diff)

    # CHECKOUT
    checkout_parser = subparsers.add_parser('checkout', aliases=['co'],
                                            help=("Checkout (revert) files "
                                                  "from changelists"),
                                            description=(
                                                "Revert files in one or more "
                                                "changelists to their HEAD "
                                                "state, discarding both "
                                                "staged and unstaged changes "
                                                "in those files. Deleted "
                                                "files are restored. Files "
                                                "that are not in HEAD, "
                                                "untracked or newly added, "
                                                "are left as they are: "
                                                "checkout never deletes a "
                                                "file. By default, asks for "
                                                "confirmation before "
                                                "proceeding."))
    checkout_parser.add_argument('names', metavar='CHANGELIST', nargs='+',
                                 help='One or more changelists to checkout')
    checkout_parser.add_argument('--delete', action='store_true',
                                 help='Delete the changelist after checkout')
    checkout_parser.add_argument('--force', '-f', action='store_true',
                                 help='Skip confirmation prompt')
    checkout_parser.set_defaults(func=cl_checkout)

    # STAGE
    stage_parser = subparsers.add_parser('stage',
                                         help=("Stage tracked files from "
                                               "one or more changelists"),
                                         description=(
                                             "Stage all tracked files from "
                                             "the specified changelist(s). "
                                             "If any named changelist does "
                                             "not exist, nothing is staged. "
                                             "Only "
                                             "files already tracked by Git "
                                             "will be staged. Untracked files "
                                             "in the changelist are safely "
                                             "ignored and remain untracked. "
                                             "By default, the changelists "
                                             "are kept unless --delete is "
                                             "used."))
    stage_parser.add_argument('names', metavar='CHANGELIST', nargs='+',
                              help='Name(s) of the changelist(s) to stage')
    stage_parser.add_argument('--delete', action='store_true',
                              help='Delete the changelist(s) after staging')
    stage_parser.set_defaults(func=cl_stage)

    # UNSTAGE
    unstage_parser = subparsers.add_parser('unstage',
                                           help=("Unstage tracked files from "
                                                 "one or more changelists"),
                                           description=(
                                               "Unstage all staged files from "
                                               "the specified changelist(s), "
                                               "moving them back to unstaged "
                                               "state in the working "
                                               "directory. If any named "
                                               "changelist does not exist, "
                                               "nothing is unstaged. By "
                                               "default, the changelists are "
                                               "kept unless --delete is "
                                               "used."))
    unstage_parser.add_argument('names', metavar='CHANGELIST', nargs='+',
                                help='Name(s) of the changelist(s) to unstage')
    unstage_parser.add_argument('--delete', action='store_true',
                                help=('Delete the changelist(s) after '
                                      'unstaging'))
    unstage_parser.set_defaults(func=cl_unstage)

    # COMMIT
    commit_parser = subparsers.add_parser('commit', aliases=['ci'],
                                          help=("Commit tracked files from "
                                                "one or more changelists "
                                                "(auto-stages, ignores "
                                                "untracked)"),
                                          description=(
                                              "Stage and commit all tracked "
                                              "files from the specified "
                                              "changelist(s) as a single "
                                              "commit using the provided "
                                              "message. Untracked files in "
                                              "the changelists are ignored "
                                              "and remain untracked. If any "
                                              "named changelist does not "
                                              "exist, nothing is committed. "
                                              "By default, the changelists "
                                              "are deleted after committing "
                                              "unless --keep is used."))
    commit_parser.add_argument('names', metavar='CHANGELIST', nargs='+',
                               help='Name(s) of the changelist(s) to commit')
    msg_group = commit_parser.add_mutually_exclusive_group(required=True)
    msg_group.add_argument('-m', '--message',
                           help='Commit message')
    msg_group.add_argument('-F', '--file',
                           help='Read commit message from file')
    commit_parser.add_argument('--keep', action='store_true',
                               help='Keep the changelist(s) after committing')
    commit_parser.set_defaults(func=cl_commit)

    # STASH
    stash_parser = subparsers.add_parser('stash', aliases=['sh'],
                                         help='Stash changes in changelist(s)',
                                         description=(
                                             "Stash the changes of the files "
                                             "in the specified changelist: "
                                             "unstaged changes, newly added "
                                             "files and untracked files. A "
                                             "changelist with files that "
                                             "have only staged changes or "
                                             "no changes is refused. Use "
                                             "--all to stash all active "
                                             "changelists at once."))
    stash_group = stash_parser.add_mutually_exclusive_group(required=True)
    stash_group.add_argument('name', nargs='?', metavar='CHANGELIST',
                             help='Name of the changelist to stash')
    stash_group.add_argument('--all', action='store_true',
                             help='Stash all active changelists')
    stash_parser.set_defaults(func=cl_stash)

    # UNSTASH
    unstash_parser = subparsers.add_parser('unstash', aliases=['us'],
                                           help=("Restore stashed "
                                                 "changelist(s)"),
                                           description=(
                                               "Restore a previously stashed "
                                               "changelist to the working "
                                               "directory. Enforces clean "
                                               "branch workflow by default "
                                               "(use --force to override). "
                                               "Use --all to unstash all "
                                               "stashed changelists to the "
                                               "current branch."))
    unstash_group = unstash_parser.add_mutually_exclusive_group(required=True)
    unstash_group.add_argument('name', nargs='?', metavar='CHANGELIST',
                               help='Name of the changelist to unstash')
    unstash_group.add_argument('--all', action='store_true',
                               help='Unstash all stashed changelists')
    unstash_parser.add_argument('--force', action='store_true',
                                help=("Force unstash even if branch/"
                                      "conflicts detected"))
    unstash_parser.set_defaults(func=cl_unstash)

    # BRANCH
    branch_parser = subparsers.add_parser('branch', aliases=['br'],
                                          help=("Create branch from "
                                                "changelist workflow"),
                                          description=(
                                              "Automate the changelist-to-"
                                              "branch workflow: stash all "
                                              "active changelists, create a "
                                              "new branch, and unstash the "
                                              "specified changelist to the "
                                              "new branch. This provides a "
                                              "clean way to move changelist "
                                              "work to a dedicated "
                                              "feature branch."))
    branch_parser.add_argument('changelist_name', metavar='CHANGELIST',
                               help=("Name of the changelist to "
                                     "create branch for"))
    branch_parser.add_argument('branch_name',
                               metavar='BRANCH', nargs='?',
                               help=("Name of the new branch "
                                     "(defaults to changelist name)"))
    branch_parser.add_argument('--from', dest='from_branch',
                               metavar='BASE_BRANCH',
                               help=("Create branch from specified base "
                                     "branch (default: current branch)"))
    branch_parser.set_defaults(func=cl_branch)

    # HELP
    help_parser = subparsers.add_parser('help',
                                        help='Show this help message',
                                        description=(
                                            "Displays a summary of "
                                            "available git-cl commands."))
    help_parser.set_defaults(func=cl_help, parser=parser)

    args = parser.parse_args()

    # If no command was provided, show help
    if args.command is None:
        parser.print_help()
        return

    # Provide parser to all commands in case needed
    if not hasattr(args, 'parser'):
        args.parser = parser

    # Every command returns True on success and False on failure, so that
    # scripts can rely on the exit code (0 or 1). argparse itself exits
    # with 2 on invalid usage before a command runs.
    # git-cl changes to the repository root for some Git commands. Make
    # relative paths in Git's environment absolute first, so that they
    # keep pointing to the same place.
    for variable in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE",
                     "GIT_COMMON_DIR"):
        value = os.environ.get(variable)
        if value and not os.path.isabs(value):
            os.environ[variable] = os.path.abspath(value)

    try:
        succeeded = args.func(args)
        sys.stdout.flush()
    except (ClutilSaveError, ClutilLoadError):
        # The reason has already been printed by the save or load function.
        sys.exit(1)
    except BrokenPipeError:
        # The reader closed the pipe early, as in 'git cl status | head'.
        # Exit quietly like git does. Output still buffered for the closed
        # pipe is sent to os.devnull, so that Python does not report the
        # same error again when it flushes stdout at exit.
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(1)
    sys.exit(0 if succeeded else 1)


if __name__ == '__main__':
    main()
